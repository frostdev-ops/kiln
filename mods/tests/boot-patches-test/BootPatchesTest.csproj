<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lab test of a boot generation's resource patches (chapter 08, S10). Build into $KILN_OUT/mods/boot-patches-test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Progression.Diagnostics is a lab member ([Experimental("KILNX001")]). -->
    <NoWarn>$(NoWarn);KILNX001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Players/Kiln.Players.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="expect.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="blocks/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
