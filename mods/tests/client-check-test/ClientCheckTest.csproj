<Project Sdk="Microsoft.NET.Sdk">
  <!-- Guided check runner test (docs/kiln/modding/testing.md, "Guided checks"): side both. A lab server runs it through
       kiln/control/checks/ and the joined channel (fixtures/client_checks_lab.py); a client shows the same checks in its
       check list. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>ClientCheckTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/Kiln.Testing/Kiln.Testing.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="fixtures/**" />
    <None Remove="fixtures/**" />
  </ItemGroup>
</Project>
