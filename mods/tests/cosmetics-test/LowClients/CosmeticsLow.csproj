<Project Sdk="Microsoft.NET.Sdk">
  <!-- Part of cosmetics-test: blocks/*.json with no code of its own, in a mod that says clients kiln. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- On purpose not in blocks/ in the repository: two of these are wrong, and the repository's mods must pass the linter. -->
    <None Include="fixtures/low.json" Link="blocks/low.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
