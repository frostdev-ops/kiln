<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fault mod of Mod.OnBoot (chapter 08 §6): OnBoot stages an item, then throws. Kiln leaves it (and boot-dependent, which requires it)
       out of the boot generation: none of its definitions or files are in, its runtime instance is refused until a restart. With "boot":
       "required" in its kiln.mod.json the same failure stops the start (exit code 0x4B01). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>BootCallbackFail</AssemblyName>
    <NoWarn>$(NoWarn);KILNX001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Blocks/Kiln.Blocks.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
