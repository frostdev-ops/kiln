    "Weapon_T1_2H_Staff_01": { "rarity": "epic" },
    "Armor_T1_Warrior_DPS_Helmet": { "armor": { "magical": { "add": 5 } } },
    "Weapon_T1_2H_Bow_01": { "levels": [1, 55], "power": 35 },
