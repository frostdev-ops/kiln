<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pacing lab test mod: prints "pacing-test: PASS|FAIL ..." lines to kiln.log.
       Build: dotnet build mods/tests/pacing-test -c Release -o $KILN_OUT/mods/pacing-test (artifacts-path $KILN_OUT/dotnet). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>PacingTest</AssemblyName>
    <RootNamespace>PacingTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
