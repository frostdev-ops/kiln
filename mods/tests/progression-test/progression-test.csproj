<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.progression test mod (kiln.players' progression part): prints PASS/FAIL lines to kiln.log. Build into
       $KILN_OUT/mods/progression-test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>ProgressionTest</AssemblyName>
    <RootNamespace>ProgressionTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Players/Kiln.Players.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Content/Kiln.Content.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
