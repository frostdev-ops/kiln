<Project Sdk="Microsoft.NET.Sdk">
  <!-- Companion of gamedata-test: logs "OBSERVE <what>: old -> new" whenever a watched value changes (to see the test's
       layers come off on unload / reload and come back at load). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../../managed/services/Kiln.Content/Kiln.Content.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
