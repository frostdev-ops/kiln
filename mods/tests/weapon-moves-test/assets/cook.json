{
  "format": 1,
  "comment": "weapon-moves-test's held models with moving parts: the sample's moving blade (mods/samples/WeaponMoves/make_assets.py writes the sources; build-assets.py runs both). Cooked on the lab machine from the installed game into assets/cooked/ (never committed). A second skinned model and graph of the same blade, moves_blade_l, are the left hand of a pair of daggers with a model of its own. The player's clips (the sample's fighter.gltf, retargeted as the sample's recipe does) play the test's own player states (player-states.json).",
  "tool": "modelcook",
  "out": "cooked",
  "inputs": {
    "bronze_model": {
      "guid": "9c38c7f0-fd0a-41a6-b91e-9a16287b8f59",
      "type": "keen::RenderModel",
      "comment": "Weapon_T1_1H_SwordEpic_01 (Bronze Sword): its material"
    },
    "player_skeleton": {
      "guid": "87b29df6-6518-43ef-9298-e3f85a6204b9",
      "type": "keen::ModelHierarchyResource",
      "comment": "the player's skeleton"
    }
  },
  "steps": [
    {
      "tool": "animcook",
      "op": "clips",
      "skeleton": "@player_skeleton",
      "gltf": "src/fighter.gltf",
      "comment": "the sample's own motions, authored on its own rig, played on the player's skeleton. The map is the rig's joint -> the player's joint (j<index>)",
      "retarget": {
        "map": {
          "root": "j0",
          "hips": "j1",
          "spine": "j10",
          "chest": "j13",
          "neck": "j16",
          "head": "j17",
          "clavicle_l": "j39",
          "arm_l": "j40",
          "forearm_l": "j42",
          "hand_l": "j44",
          "clavicle_r": "j69",
          "arm_r": "j70",
          "forearm_r": "j72",
          "hand_r": "j74",
          "thigh_l": "j2",
          "shin_l": "j3",
          "foot_l": "j4",
          "thigh_r": "j6",
          "shin_r": "j7",
          "foot_r": "j8"
        }
      },
      "clips": {
        "slash_1": {
          "animation": "Slash"
        },
        "cleave": {
          "animation": "Cleave"
        },
        "guard": {
          "animation": "Guard",
          "loop": true
        }
      }
    },
    {
      "tool": "animcook",
      "op": "clips",
      "skeleton": "@player_skeleton",
      "comment": "the second swing is the first one reworked: mirrored (the right arm takes the left arm's pull, so the forehand becomes a backhand) and a little faster. No gltf: every clip here has from",
      "clips": {
        "slash_2": {
          "from": "slash_1",
          "mirror": true,
          "speed": 1.15
        }
      }
    },
    {
      "tool": "animcook",
      "op": "skeleton",
      "name": "moves_blade",
      "gltf": "src/blade.gltf"
    },
    {
      "tool": "animcook",
      "op": "clips",
      "skeleton": "moves_blade",
      "gltf": "src/blade.gltf",
      "clips": {
        "blade_spin": {
          "animation": "Spin",
          "loop": true
        }
      }
    },
    {
      "tool": "animcook",
      "op": "graph",
      "name": "moves_blade",
      "skeleton": "moves_blade",
      "states": {
        "spin": {
          "engine": "Idle",
          "clip": "blade_spin"
        }
      }
    },
    {
      "tool": "animcook",
      "op": "graph",
      "name": "moves_blade_l",
      "skeleton": "moves_blade",
      "states": {
        "spin": {
          "engine": "Idle",
          "clip": "blade_spin"
        }
      }
    },
    {
      "op": "model",
      "gltf": "src/blade.gltf",
      "skeleton": "moves_blade",
      "base": "bronze_model",
      "mode": "new",
      "name": "moves_blade_anim",
      "stem": "moves_blade_anim"
    },
    {
      "op": "model",
      "gltf": "src/blade.gltf",
      "skeleton": "moves_blade",
      "base": "bronze_model",
      "mode": "new",
      "name": "moves_blade_l_anim",
      "stem": "moves_blade_l_anim"
    },
    {
      "op": "model",
      "gltf": "src/blade_rigid.gltf",
      "base": "bronze_model",
      "mode": "new",
      "name": "moves_blade",
      "stem": "moves_blade"
    }
  ]
}
