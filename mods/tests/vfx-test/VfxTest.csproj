<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.vfx test (docs/kiln/services/vfx.md): side both. Server: the relay. Simulated game (kiln/config/vfx.json "sim", a lab): the
       whole path from Kiln.Vfx to the game's door. Client: what can be checked passively, and every case that shows something on a
       key. Key 4 plays blocks/vfx.json's effect; key 4b the same effect on a game module, once the builder can make that. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>VfxTest</AssemblyName>
    <!-- Calls Kiln's lab and test members ([Experimental("KILNX001")]). -->
    <NoWarn>$(NoWarn);KILNX001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Vfx/Kiln.Vfx.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Client/Kiln.Client.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Chat/Kiln.Chat.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Network/Kiln.Network.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.World/Kiln.World.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Ui/Kiln.Ui.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="vfx/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="blocks/**" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="fixtures/**" />
    <None Remove="fixtures/**" />
  </ItemGroup>
</Project>
