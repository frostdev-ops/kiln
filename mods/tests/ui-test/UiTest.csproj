<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.ui game-UI test (client): PASS/FAIL lines in kiln.log for the screen state, the menu entries, the crafting
       menu extension, screens, images and texts. Some lines wait for the player's actions (client checklist). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Ui/Kiln.Ui.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
