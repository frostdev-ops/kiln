<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln.Quests test mod (the knowledge part: kiln.knowledge, Kiln.Knowledge, Journal, the dialogue and client-input
       events). Prints PASS/FAIL lines to kiln.log. Build into $KILN_OUT/mods/quests-test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>QuestsTest</AssemblyName>
    <RootNamespace>QuestsTest</RootNamespace>
    <!-- Calls Kiln's lab and test members ([Experimental("KILNX001")]). -->
    <NoWarn>$(NoWarn);KILNX001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Players/Kiln.Players.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Quests/Kiln.Quests.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
