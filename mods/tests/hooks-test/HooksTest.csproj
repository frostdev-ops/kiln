<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.hooks test mod: prints "hooks-test: PASS|FAIL ..." lines to kiln.log.
       Build: dotnet build mods/tests/hooks-test -c Release -o $KILN_OUT/mods/hooks-test (artifacts-path $KILN_OUT/dotnet). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Hooks/Kiln.Hooks.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sigdb/server.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
