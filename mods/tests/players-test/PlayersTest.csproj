<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.players test mod: prints PASS/FAIL lines to kiln.log. Build into $KILN_OUT/mods/players-test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>PlayersTest</AssemblyName>
    <RootNamespace>PlayersTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Players/Kiln.Players.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/*.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- autostart/ is a mod of its own (no Kiln.Players reference), built separately. -->
    <Compile Remove="autostart/**" />
    <None Remove="autostart/**" />
  </ItemGroup>
</Project>
