<Project>
  <!-- Lab test of block kinds, the provider half (chapter 16d): the LanternKind and a kind that is always refused. It
       references only the public SDK. kinds-consumer-test drives it with inter-mod messages (retire, restore, apply-foreign). -->
  <Import Project="../../../managed/Kiln.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <KilnModId>kinds-provider-test</KilnModId>
    <KilnModName>block kinds lab test, provider</KilnModName>
    <Version>0.1.0</Version>
    <Description>Registers the lab's block kinds. PASS/FAIL lines come from kinds-consumer-test, and one from here.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <KilnServices>Blocks</KilnServices>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <KilnExports>KindsProviderTest.Api.dll</KilnExports>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Api/KindsProviderTest.Api.csproj" />
    <Compile Remove="Api/**" />
  </ItemGroup>
  <Import Project="../../../managed/Kiln.Sdk/Sdk/Sdk.targets" />
</Project>
