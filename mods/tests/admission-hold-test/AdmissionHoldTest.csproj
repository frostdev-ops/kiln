<Project Sdk="Microsoft.NET.Sdk">
  <!-- The guided check 15a-hold-kiln's fixture (server side): NetAdmission holds each joining Kiln client for
       holdSeconds (kiln/config/admission-hold-test.json, read at each join), then lets it in; 25 or more and the hold's
       deadline refuses it. Every outcome goes to kiln/data/admission-hold-test/joins.json. Build into
       $KILN_OUT/mods/admission-hold-test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>AdmissionHoldTest</AssemblyName>
    <RootNamespace>AdmissionHoldTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Network/Kiln.Network.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
