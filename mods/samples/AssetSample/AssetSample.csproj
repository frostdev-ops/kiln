<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln asset-layer sample. Data-only assets (assets/assets.json: icon + retexture) loaded natively at boot; the
       new item + recipe come from content/assetsample.json (kiln.content). The managed side only reports status. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Assets/Kiln.Assets.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="content/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="content" />
    <None Include="assets/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="assets" />
    <None Include="assets/*.png" CopyToOutputDirectory="PreserveNewest" LinkBase="assets" />
  </ItemGroup>
</Project>
