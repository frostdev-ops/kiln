{
  // Affix blocks: the same shapes as the C# records AffixBlock and AffixPoolBlock. Kiln reads every file in the mod's
  // blocks/ folder by itself, a few steps after the mod loaded; the code finds the pool by its name.
  "format": 1,
  "affixes": {
    // whole points: 2 to 4 Strength, and on a sword of item level 20 or more sometimes 5 to 8
    "bear": { "name": "of the Bear", "stat": "strength",
              "tiers": [ { "min": 2, "max": 4 }, { "min": 5, "max": 8, "weight": 0.5, "minItemLevel": 20 } ] },
    // a share: 5, 10 or 15 % faster. Two swords with it do not add up: the faster one counts
    "fleet": { "name": "Fleet", "stat": "move-speed", "stacks": false,
               "tiers": [ { "min": 0.05, "max": 0.15, "step": 0.05 } ] },
    // a resistance: 10 to 25 % less fire damage taken, in whole percents
    "ember-ward": { "name": "Ember Ward", "stat": "resist-fire",
                    "tiers": [ { "min": 0.10, "max": 0.25 } ] }
  },
  "affixPools": {
    // every roll gives this sword exactly one of the three; Fleet comes up twice as often
    "blades": { "items": [ "Weapon_T1_1H_SwordEpic_01" ],
                "affixes": [ { "affix": "bear" }, { "affix": "fleet", "weight": 2 }, { "affix": "ember-ward" } ] }
  }
}
