<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sample of Mod.OnBoot (docs/kiln/modding/onboot.md): content a first start already has. OnBoot reads the game's data and stages a status,
       an effect, an item, a spell and a game-tree talent; OnLoad defines nothing. No bake (KilnBake=false): a baked file must not hide what
       the boot generation does. Needs the boot game-data snapshot (README.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>BootGallery</AssemblyName>
    <KilnBake>false</KilnBake>
    <NoWarn>$(NoWarn);KILNX001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Blocks/Kiln.Blocks.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
