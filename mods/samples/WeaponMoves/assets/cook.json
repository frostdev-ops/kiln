{
  "format": 1,
  "comment": "WeaponMoves' cook recipe: run on each player's machine (kiln cook), reading the installed game; it writes assets/cooked/ (never committed). The sources are assets/src/*.gltf, made by make_assets.py: no game data. Read from the game: the player's skeleton (the clips are retargeted onto it) and the Bronze Sword's model (its material draws the sword).",
  "tool": "modelcook",
  "out": "cooked",
  "inputs": {
    "player_skeleton": { "guid": "87b29df6-6518-43ef-9298-e3f85a6204b9", "type": "keen::ModelHierarchyResource", "comment": "the player's skeleton" },
    "bronze_model": { "guid": "9c38c7f0-fd0a-41a6-b91e-9a16287b8f59", "type": "keen::RenderModel", "comment": "Weapon_T1_1H_SwordEpic_01 (Bronze Sword): its material" }
  },
  "steps": [
    { "tool": "animcook", "op": "clips", "skeleton": "@player_skeleton", "gltf": "src/fighter.gltf",
      "comment": "the sample's own motions, authored on its own rig, played on the player's skeleton. The map is the rig's joint -> the player's joint (j<index>)",
      "retarget": { "map": {
        "root": "j0", "hips": "j1", "spine": "j10", "chest": "j13", "neck": "j16", "head": "j17",
        "clavicle_l": "j39", "arm_l": "j40", "forearm_l": "j42", "hand_l": "j44",
        "clavicle_r": "j69", "arm_r": "j70", "forearm_r": "j72", "hand_r": "j74",
        "thigh_l": "j2", "shin_l": "j3", "foot_l": "j4", "thigh_r": "j6", "shin_r": "j7", "foot_r": "j8" } },
      "clips": {
        "slash_1": { "animation": "Slash" },
        "cleave": { "animation": "Cleave" },
        "guard": { "animation": "Guard", "loop": true } } },
    { "tool": "animcook", "op": "clips", "skeleton": "@player_skeleton",
      "comment": "the second swing is the first one reworked: mirrored (the right arm takes the left arm's pull, so the forehand becomes a backhand) and a little faster. No gltf: every clip here has from",
      "clips": {
        "slash_2": { "from": "slash_1", "mirror": true, "speed": 1.15 } } },
    { "tool": "animcook", "op": "skeleton", "name": "moves_blade", "gltf": "src/blade.gltf" },
    { "tool": "animcook", "op": "clips", "skeleton": "moves_blade", "gltf": "src/blade.gltf",
      "clips": { "blade_spin": { "animation": "Spin", "loop": true } } },
    { "tool": "animcook", "op": "graph", "name": "moves_blade", "skeleton": "moves_blade",
      "states": { "spin": { "engine": "Idle", "clip": "blade_spin" } } },
    { "op": "model", "gltf": "src/blade.gltf", "skeleton": "moves_blade", "base": "bronze_model", "mode": "new", "name": "moves_blade_anim", "stem": "moves_blade_anim" },
    { "op": "model", "gltf": "src/blade_rigid.gltf", "base": "bronze_model", "mode": "new", "name": "moves_blade", "stem": "moves_blade" }
  ]
}
