<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sample: a mod's own particle module (docs/kiln/modding/shaders.md). The effects are in blocks/vfx.json (kiln.vfx builds them natively at boot), the module's
       source in shaders/swirl.hlsl and what ships in shaders/build/swirl.spv: rebuild it with kiln-vfxcook shader build (mod folder mods/samples/ShaderSample). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Vfx/Kiln.Vfx.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Client/Kiln.Client.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Ui/Kiln.Ui.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.World/Kiln.World.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="blocks/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="vfx/*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="shaders/build/*.spv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
