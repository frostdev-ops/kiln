<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine room sample (docs/kiln/modding/typed-fields.md "Any resource", ecs-programs.md "Hooks around game
       systems"): the game's systems listed, profiled and hooked (GameSystems), one field of a game resource changed
       as a claim (ReflectedResources), a reversible change of the mod's own (Overrides.Claim).
       Build: dotnet build mods/samples/EngineRoom -c Release -o $KILN_OUT/mods/engine-room -artifacts-path $KILN_OUT/dotnet -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Chat/Kiln.Chat.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
