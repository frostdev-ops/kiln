<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sample: spell and ability tuning with a kiln.gamedata data pack (content/spelltweaks.json); the code only logs the
       values the game now uses. Server-side changes: vanilla clients play along; Kiln clients get the values (sync). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../managed/Kiln.Api/Kiln.Api.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../managed/services/Kiln.Content/Kiln.Content.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="content/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="content" />
  </ItemGroup>
</Project>
