{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiln Launcher",
  "mainBinaryName": "kiln-launcher",
  "identifier": "io.frostdev.kiln.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "Kiln",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": true,
        "backgroundColor": "#080504"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: asset: http://asset.localhost kiln-asset: http://kiln-asset.localhost; font-src 'self' data: kiln-asset: http://kiln-asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost kiln-asset: http://kiln-asset.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFN0M5OTVENEM1MDVDREYKUldUZlhGQk1YWmw4bmhPY1dFNkwrejVRODJ6UUNwSk4zbGQxcWlZL1ExUnIyK1ZHU0FRV1dxOFMK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "frostdev",
    "category": "Game",
    "shortDescription": "Mods for Enshrouded",
    "longDescription": "Kiln Launcher: install Kiln, manage mod profiles, play, run and administer servers.",
    "copyright": "Kiln contributors, MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
