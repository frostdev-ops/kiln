<Project Sdk="Kiln.Sdk/KILN_SDK_VERSION">
  <!-- A network channel between this mod on the server and this mod in a player's game: typed messages each way. Docs: docs/kiln/services/network.md.
       Build: the output folder is the mod folder (KilnNetwork1.dll + generated kiln.mod.json).
         dotnet build -t:KilnDeploy -p:KilnServer=<server folder> [-p:KilnReload=true]   copy into <server>/kiln/mods/<id>
         dotnet build -t:KilnPack                                                       <id>-<version>.zip
       Every property is documented in Kiln.Sdk's Sdk/Kiln.Mod.targets and docs/kiln/modding/mdk.md. -->
  <PropertyGroup>
    <KilnModId>kiln-mod-id</KilnModId>
    <KilnModName>KilnNetwork1</KilnModName>
    <Version>0.1.0</Version>
    <Description>KilnNetwork1, a Kiln mod.</Description>
    <!-- <PackageLicenseExpression>MIT</PackageLicenseExpression>   the licence others may use it under (kiln.mod.json "license") -->
    <!-- Kiln service assemblies this mod uses (they ship with Kiln, never with the mod). -->
    <KilnServices>Network;Players</KilnServices>
    <!-- The mod runs in the server and in every player's game. KilnClients says what a joining player needs:
         "mod" (the default for side both): players without this mod are told so; "kiln": Kiln is enough. -->
    <KilnSide>both</KilnSide>
<!--#if (hasServer)-->
    <KilnServer>KILN_SERVER</KilnServer>
<!--#endif-->
  </PropertyGroup>
</Project>
