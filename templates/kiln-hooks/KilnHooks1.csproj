<Project Sdk="Kiln.Sdk/KILN_SDK_VERSION">
  <!-- A hook into the game's own code (the advanced tier, kiln.hooks): a detour on a function Kiln has a symbol for, which counts calls and runs the original. Docs: docs/kiln/services/hooks.md.
       Build: the output folder is the mod folder (KilnHooks1.dll + generated kiln.mod.json).
         dotnet build -t:KilnDeploy -p:KilnServer=<server folder> [-p:KilnReload=true]   copy into <server>/kiln/mods/<id>
         dotnet build -t:KilnPack                                                       <id>-<version>.zip
       Every property is documented in Kiln.Sdk's Sdk/Kiln.Mod.targets and docs/kiln/modding/mdk.md. -->
  <PropertyGroup>
    <KilnModId>kiln-mod-id</KilnModId>
    <KilnModName>KilnHooks1</KilnModName>
    <Version>0.1.0</Version>
    <Description>KilnHooks1, a Kiln mod.</Description>
    <!-- <PackageLicenseExpression>MIT</PackageLicenseExpression>   the licence others may use it under (kiln.mod.json "license") -->
    <!-- Kiln service assemblies this mod uses (they ship with Kiln, never with the mod). -->
    <KilnServices>Hooks</KilnServices>
    <!-- Hooks and symbols are the advanced tier: the manifest says "advanced": true, the launcher shows it, and a
         game update can break such a mod where a mod on Kiln's ordinary API keeps working. -->
    <KilnAdvanced>true</KilnAdvanced>
<!--#if (hasServer)-->
    <KilnServer>KILN_SERVER</KilnServer>
<!--#endif-->
  </PropertyGroup>
</Project>
