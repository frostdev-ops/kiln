<Project Sdk="Kiln.Sdk/KILN_SDK_VERSION">
  <!-- A particle effect moved by this mod's own shader hooks: shaders/swirl.hlsl is the source, shaders/build/swirl.spv what ships (rebuild with kiln-vfxcook: its "shader build" command with the mod folder), blocks/vfx.json the effect. A player's game draws it (F7 with the hooks, Shift+F7 without). Docs: docs/kiln/modding/shaders.md.
       Build: the output folder is the mod folder (KilnShader1.dll + generated kiln.mod.json).
         dotnet build -t:KilnDeploy -p:KilnServer=<server folder> [-p:KilnReload=true]   copy into <server>/kiln/mods/<id>
         dotnet build -t:KilnPack                                                       <id>-<version>.zip
       Every property is documented in Kiln.Sdk's Sdk/Kiln.Mod.targets and docs/kiln/modding/mdk.md. -->
  <PropertyGroup>
    <KilnModId>kiln-mod-id</KilnModId>
    <KilnModName>KilnShader1</KilnModName>
    <Version>0.1.0</Version>
    <Description>KilnShader1, a Kiln mod.</Description>
    <!-- <PackageLicenseExpression>MIT</PackageLicenseExpression>   the licence others may use it under (kiln.mod.json "license") -->
    <!-- Kiln service assemblies this mod uses (they ship with Kiln, never with the mod). -->
    <KilnServices>Blocks;Vfx;Client;Ui;World</KilnServices>
    <!-- Every player's game draws the effect, so the mod has to be on theirs too. -->
    <KilnSide>both</KilnSide>
    <KilnClients>mod</KilnClients>
    <!-- The data folders that go into the mod folder. shaders/ is not in Kiln.Sdk's default list, so it is named here
         (with the two this mod has): shaders/build/*.spv is what the game loads; the .hlsl beside it is harmless. -->
    <KilnModFolders>blocks;vfx;shaders</KilnModFolders>
<!--#if (hasServer)-->
    <KilnServer>KILN_SERVER</KilnServer>
<!--#endif-->
  </PropertyGroup>
</Project>
