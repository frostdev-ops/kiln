{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kiln contributors",
  "classifications": [
    "Kiln",
    "Enshrouded",
    "Mod",
    "Test"
  ],
  "identity": "Kiln.Templates.Test",
  "groupIdentity": "Kiln.Templates.Test",
  "name": "Kiln test mod",
  "description": "A test mod (Kiln.Testing, Forge's GameTest): [KilnTest] methods that run inside the server on the tick thread, auto-run when the world is live, results in kiln/logs/tests/<id>.json.",
  "shortName": "kiln-test",
  "sourceName": "KilnTest1",
  "preferNameDirectory": true,
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project",
    "kiln.kind": "test"
  },
  "symbols": {
    "modId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Mod id ([a-z0-9][a-z0-9._-]*); default: the name in kebab-case"
    },
    "modIdDefault": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab"
    },
    "modIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "modId",
        "fallbackVariableName": "modIdDefault"
      },
      "replaces": "kiln-mod-id"
    },
    "kilnSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.2.0",
      "replaces": "KILN_SDK_VERSION",
      "description": "Kiln.Sdk version (the MDK this template came with)"
    },
    "feed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_FEED",
      "description": "Local NuGet feed holding Kiln.Sdk/Kiln.Api (writes a nuget.config next to the project)"
    },
    "hasFeed": {
      "type": "computed",
      "value": "(feed != \"\")"
    },
    "server": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_SERVER",
      "description": "Server (or game) folder with Kiln for deploy (KilnServer)"
    },
    "hasServer": {
      "type": "computed",
      "value": "(server != \"\")"
    },
    "target": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_DEP_ID",
      "description": "Id of the mod under test (adds a dependency on it)"
    },
    "hasTarget": {
      "type": "computed",
      "value": "(target != \"\")"
    },
    "targetOrSelf": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "target",
        "fallbackVariableName": "modIdValue"
      },
      "replaces": "KILN_UNDER_TEST"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!hasFeed)",
          "exclude": [
            "nuget.config"
          ]
        }
      ]
    }
  ],
  "postActions": []
}
