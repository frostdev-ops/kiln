<Project Sdk="Kiln.Sdk/KILN_SDK_VERSION">
  <!-- Player powers from building blocks (KilnAbilityBlocks1Mod.cs, and the same kinds as data in blocks/). Docs: docs/kiln/modding/blocks.md.
         dotnet build -t:KilnDeploy [-p:KilnServer=<server folder>] [-p:KilnReload=true]    (or: kiln deploy)
       Then `kiln blocks show <name>` says what a block became, and `kiln lint` checks blocks/*.json. -->
  <PropertyGroup>
    <KilnModId>kiln-mod-id</KilnModId>
    <KilnModName>KilnAbilityBlocks1</KilnModName>
    <Version>0.1.0</Version>
    <Description>KilnAbilityBlocks1: player powers from blocks.</Description>
    <KilnServices>Blocks;Abilities;Players</KilnServices>
<!--#if (hasServer)-->
    <KilnServer>KILN_SERVER</KilnServer>
<!--#endif-->
  </PropertyGroup>
</Project>
