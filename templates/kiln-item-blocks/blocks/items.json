  "$schema": "https://raw.githubusercontent.com/frostdev-ops/kiln/main/schema/kiln-blocks.schema.json",
  "format": 1,
  "statuses": {
    "well-fed": { "name": "Well Fed", "kind": "buff", "seconds": 600, "modifies": { "move-speed": 0.05 } }
  },
  "items": {
