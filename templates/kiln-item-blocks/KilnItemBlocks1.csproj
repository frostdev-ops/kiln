<Project Sdk="Kiln.Sdk/KILN_SDK_VERSION">
  <!-- Items from building blocks (KilnItemBlocks1Mod.cs, and the same kinds as data in blocks/). No GUIDs and no base items: what players' games need follows from the blocks. Docs: docs/kiln/modding/item-blocks.md.
         dotnet build -t:KilnDeploy [-p:KilnServer=<server folder>] [-p:KilnReload=true]    (or: kiln deploy)
       Then `kiln blocks show <name>` says what a block became, and `kiln lint` checks blocks/*.json. -->
  <PropertyGroup>
    <KilnModId>kiln-mod-id</KilnModId>
    <KilnModName>KilnItemBlocks1</KilnModName>
    <Version>0.1.0</Version>
    <Description>KilnItemBlocks1: new items from blocks.</Description>
    <KilnServices>Blocks</KilnServices>
<!--#if (hasServer)-->
    <KilnServer>KILN_SERVER</KilnServer>
<!--#endif-->
  </PropertyGroup>
</Project>
