{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kiln contributors",
  "classifications": [
    "Kiln",
    "Enshrouded",
    "Mod",
    "Gameplay"
  ],
  "identity": "Kiln.Templates.Ability",
  "groupIdentity": "Kiln.Templates.Ability",
  "name": "Kiln ability",
  "description": "A new ability (kiln.abilities): key + chat command, mana cost, cooldown, cast time, game explosions; optionally an Impact program written from scratch with its cook recipe.",
  "shortName": "kiln-ability",
  "sourceName": "KilnAbility1",
  "preferNameDirectory": true,
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project",
    "kiln.kind": "ability"
  },
  "symbols": {
    "modId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Mod id ([a-z0-9][a-z0-9._-]*); default: the name in kebab-case"
    },
    "modIdDefault": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab"
    },
    "modIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "modId",
        "fallbackVariableName": "modIdDefault"
      },
      "replaces": "kiln-mod-id"
    },
    "kilnSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.2.0",
      "replaces": "KILN_SDK_VERSION",
      "description": "Kiln.Sdk version (the MDK this template came with)"
    },
    "feed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_FEED",
      "description": "Local NuGet feed holding Kiln.Sdk/Kiln.Api (writes a nuget.config next to the project)"
    },
    "hasFeed": {
      "type": "computed",
      "value": "(feed != \"\")"
    },
    "server": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_SERVER",
      "description": "Server (or game) folder with Kiln for deploy (KilnServer)"
    },
    "hasServer": {
      "type": "computed",
      "value": "(server != \"\")"
    },
    "impact": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Add an Impact program (impact/regen.kimp + impact/cook.json, cooked with kiln cook)"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!hasFeed)",
          "exclude": [
            "nuget.config"
          ]
        },
        {
          "condition": "(!impact)",
          "exclude": [
            "impact/**",
            "assets/**",
            ".gitignore"
          ]
        }
      ]
    }
  ],
  "postActions": [],
  "guids": [
    "0f4c7e93-2b6a-4d18-a9e5-7c3b1f8d2e40"
  ]
}
