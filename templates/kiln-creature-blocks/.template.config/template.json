{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kiln contributors",
  "classifications": [
    "Kiln",
    "Enshrouded",
    "Mod",
    "Content"
  ],
  "identity": "Kiln.Templates.CreatureBlocks",
  "groupIdentity": "Kiln.Templates.CreatureBlocks",
  "name": "Kiln creature blocks",
  "description": "A creature from building blocks, as data: a game body, a tuned AI, a behaviour with a rule, a loot table it drops and where it spawns (blocks/*.json). No clones, no GUIDs.",
  "shortName": "kiln-creature-blocks",
  "sourceName": "KilnCreatureBlocks1",
  "preferNameDirectory": true,
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    },
    "xmlAttribute": {
      "identifier": "chain",
      "steps": [
        "xmlEncode",
        "xmlQuote"
      ]
    },
    "xmlQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "&quot;"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project",
    "kiln.kind": "creature"
  },
  "symbols": {
    "modId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Mod id ([a-z0-9][a-z0-9._-]*); default: the name in kebab-case"
    },
    "modIdDefault": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab"
    },
    "modIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "modId",
        "fallbackVariableName": "modIdDefault"
      },
      "replaces": "kiln-mod-id"
    },
    "kilnSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.2.0",
      "replaces": "KILN_SDK_VERSION",
      "description": "Kiln.Sdk version (the MDK this template came with)"
    },
    "feed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Local NuGet feed holding Kiln.Sdk/Kiln.Api (writes a nuget.config next to the project)"
    },
    "feedXml": {
      "type": "derived",
      "valueSource": "feed",
      "valueTransform": "xmlAttribute",
      "replaces": "KILN_FEED"
    },
    "hasFeed": {
      "type": "computed",
      "value": "(feed != \"\")"
    },
    "server": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Server (or game) folder with Kiln for deploy (KilnServer)"
    },
    "serverXml": {
      "type": "derived",
      "valueSource": "server",
      "valueTransform": "xmlEncode",
      "replaces": "KILN_SERVER"
    },
    "hasServer": {
      "type": "computed",
      "value": "(server != \"\")"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!hasFeed)",
          "exclude": [
            "nuget.config"
          ]
        }
      ]
    }
  ],
  "postActions": [],
  "guids": [
    "fb06c511-33ff-42da-a7e5-0374c927fb74"
  ]
}
