{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kiln contributors",
  "classifications": [
    "Kiln",
    "Enshrouded",
    "Mod",
    "Assets"
  ],
  "identity": "Kiln.Templates.Sound",
  "groupIdentity": "Kiln.Templates.Sound",
  "name": "Kiln sound",
  "description": "A sound mod: audio sources + assets/cook.json (soundcook) giving a new sound and cue, served by kiln.assets; play it with Kiln.Audio.",
  "shortName": "kiln-sound",
  "sourceName": "KilnSound1",
  "preferNameDirectory": true,
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project",
    "kiln.kind": "sound"
  },
  "symbols": {
    "modId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Mod id ([a-z0-9][a-z0-9._-]*); default: the name in kebab-case"
    },
    "modIdDefault": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab"
    },
    "modIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "modId",
        "fallbackVariableName": "modIdDefault"
      },
      "replaces": "kiln-mod-id"
    },
    "kilnSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.2.0",
      "replaces": "KILN_SDK_VERSION",
      "description": "Kiln.Sdk version (the MDK this template came with)"
    },
    "feed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_FEED",
      "description": "Local NuGet feed holding Kiln.Sdk/Kiln.Api (writes a nuget.config next to the project)"
    },
    "hasFeed": {
      "type": "computed",
      "value": "(feed != \"\")"
    },
    "server": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_SERVER",
      "description": "Server (or game) folder with Kiln for deploy (KilnServer)"
    },
    "hasServer": {
      "type": "computed",
      "value": "(server != \"\")"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!hasFeed)",
          "exclude": [
            "nuget.config"
          ]
        }
      ]
    }
  ],
  "postActions": [],
  "guids": [
    "7a1e4c92-5f3b-4d68-8e2a-b9c06d3f1e57"
  ]
}
