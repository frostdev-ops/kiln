{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kiln contributors",
  "classifications": [
    "Kiln",
    "Enshrouded",
    "Mod",
    "Content"
  ],
  "identity": "Kiln.Templates.Creature",
  "groupIdentity": "Kiln.Templates.Creature",
  "name": "Kiln creature",
  "description": "A new creature: a template clone with its own level, size and senses (kiln.gamedata), a spawn rule that replaces a share of natural spawns (kiln.creatures), and an admin spawn command. Advanced: a content-pack clone. For a creature from blocks (body, AI, behaviour, drops) start with kiln-creature-blocks.",
  "shortName": "kiln-creature",
  "sourceName": "KilnCreature1",
  "preferNameDirectory": true,
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "tags": {
    "language": "C#",
    "type": "project",
    "kiln.kind": "creature"
  },
  "symbols": {
    "modId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Mod id ([a-z0-9][a-z0-9._-]*); default: the name in kebab-case"
    },
    "modIdDefault": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab"
    },
    "modIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "modId",
        "fallbackVariableName": "modIdDefault"
      },
      "replaces": "kiln-mod-id"
    },
    "kilnSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.2.0",
      "replaces": "KILN_SDK_VERSION",
      "description": "Kiln.Sdk version (the MDK this template came with)"
    },
    "feed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_FEED",
      "description": "Local NuGet feed holding Kiln.Sdk/Kiln.Api (writes a nuget.config next to the project)"
    },
    "hasFeed": {
      "type": "computed",
      "value": "(feed != \"\")"
    },
    "server": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_SERVER",
      "description": "Server (or game) folder with Kiln for deploy (KilnServer)"
    },
    "hasServer": {
      "type": "computed",
      "value": "(server != \"\")"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!hasFeed)",
          "exclude": [
            "nuget.config"
          ]
        }
      ]
    }
  ],
  "postActions": [],
  "guids": [
    "9d2b6f14-7a3e-4c8b-b5f0-e1c4a7d93b62"
  ]
}
