{
  "$schema": "http://json.schemastore.org/template",
  "author": "Kiln contributors",
  "classifications": [
    "Kiln",
    "Enshrouded",
    "Mod",
    "Native"
  ],
  "identity": "Kiln.Templates.Native",
  "groupIdentity": "Kiln.Templates.Native",
  "name": "Kiln native mod (C++)",
  "description": "A Kiln-aware native mod: a Windows x64 DLL in C++ built with CMake (kiln_plugin from the Kiln.Sdk package), native.json, kiln_native_init, a tick subscription; deploys to kiln/native/<id>.",
  "shortName": "kiln-native",
  "sourceName": "KilnNative1",
  "preferNameDirectory": true,
  "forms": {
    "kebab": {
      "identifier": "kebabCase"
    }
  },
  "tags": {
    "language": "C++",
    "type": "project",
    "kiln.kind": "native"
  },
  "symbols": {
    "modId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Mod id ([a-z0-9][a-z0-9._-]*); default: the name in kebab-case"
    },
    "modIdDefault": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "kebab"
    },
    "modIdValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "modId",
        "fallbackVariableName": "modIdDefault"
      },
      "replaces": "kiln-mod-id"
    },
    "kilnSdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "0.2.0",
      "replaces": "KILN_SDK_VERSION",
      "description": "Kiln.Sdk version (the MDK this template came with)"
    },
    "feed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_FEED",
      "description": "Local NuGet feed holding Kiln.Sdk/Kiln.Api (writes a nuget.config next to the project)"
    },
    "hasFeed": {
      "type": "computed",
      "value": "(feed != \"\")"
    },
    "server": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "KILN_SERVER",
      "description": "Server (or game) folder with Kiln for deploy (KilnServer)"
    },
    "hasServer": {
      "type": "computed",
      "value": "(server != \"\")"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!hasFeed)",
          "exclude": [
            "nuget.config"
          ]
        }
      ]
    }
  ],
  "postActions": []
}
