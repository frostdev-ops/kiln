<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln's own (MIT) ports of EML's data helpers, and the status of kiln-eml (the GPL-3 EML plugin, gpl/kiln-eml).
       Written from EML's documentation and observed behaviour, not from EML's code (docs/kiln/eml.md, "MIT ports").
       Deployed to kiln/host/ and shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
  </ItemGroup>
</Project>
