<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/world (kiln.world): entity access and teleport for mods. Deployed to kiln/host/
       and shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AssemblyName>Kiln.World</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- Kiln.Game hands its first-use layout check to World.Write/Update (WorldWrites.LayoutWhyNot). -->
    <InternalsVisibleTo Include="Kiln.Game" />
    <InternalsVisibleTo Include="Kiln.TestKit" />
    <InternalsVisibleTo Include="Kiln.World.Tests" />
    <InternalsVisibleTo Include="Kiln.TestKit.Tests" />
    <!-- the contract tests: the rows' names -->
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
  </ItemGroup>
</Project>
