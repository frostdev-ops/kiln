<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln.Registry: Kiln's registries (items, recipes, loot, drops, balance, lootRules, randomLoot) as typed C# entries over Kiln-owned field names,
       generated from schema/registry/*.json by tools/registrygen/registrygen.py (Generated/*.g.cs; never edit those by
       hand), plus the stage, live-change and read API over them: Mod.OnRegistry with [RegistryEntryPoints], RegistryStage,
       Registries.Change/Read and Registries.Ready (docs/kiln/modding/registries/README.md). Experimental (KILNX031).
       Deployed to kiln/host/ and shared by every mod. -->
  <PropertyGroup>
    <RootNamespace>Kiln.Registry</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- kiln.registry.view's native table (RegistryViews.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- its own types are KILNX031: using them inside the assembly is not an opt-in -->
    <NoWarn>$(NoWarn);CS1591;KILNX031</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- the generated types over a fake store of cells, and the catalog against schema/registry/*.json -->
    <InternalsVisibleTo Include="Kiln.Registry.Tests" />
  </ItemGroup>
</Project>
