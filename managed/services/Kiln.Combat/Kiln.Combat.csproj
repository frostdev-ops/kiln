<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/combat (kiln.combat): health, damage, god mode and combat events for mods.
       Deployed to kiln/host/ and shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AssemblyName>Kiln.Combat</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA2255</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
    <!-- Abilities.Attributes.Add posts CombatChangedEvent through Combat.Changed (one event for one kind of value) -->
    <InternalsVisibleTo Include="Kiln.Abilities" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
  </ItemGroup>
</Project>
