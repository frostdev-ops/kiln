<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.saves' managed face (native/services/saves, native/core/abi/services/kiln_saves.h): save events, "save now",
       backups, and persistent mod data (WorldData, PlayerData, CharacterData, EntityData). Deployed to kiln/host/ and shared by every
       mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA2255</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Blocks.Tests" />
    <InternalsVisibleTo Include="Kiln.Saves.Tests" />
    <!-- 19d: Kiln.Pets keeps its per-character records through ServiceCharacters (service scope, staged receipts) -->
    <InternalsVisibleTo Include="Kiln.Pets" />
    <InternalsVisibleTo Include="Kiln.Pets.Tests" />
    <InternalsVisibleTo Include="Kiln.World.Tests" />
    <InternalsVisibleTo Include="Kiln.Terrain" />
    <InternalsVisibleTo Include="Kiln.TestKit" />
    <!-- Kiln.ModValues: its ledger's explicit-owner records (CharacterStore), the live character sessions and the
         sidecar's reserved projection (CharacterSync). Kiln.Saves never references it. -->
    <InternalsVisibleTo Include="Kiln.ModValues" />
    <InternalsVisibleTo Include="Kiln.ModValues.Tests" />
    <!-- the contract tests: the rows' names -->
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- CharacterSync: the channel "kiln:character" (Kiln.Network brings Kiln.Players and Kiln.Client along). The rest of
         this assembly still reads other services through their native tables (Foreign.cs). -->
    <ProjectReference Include="../Kiln.Network/Kiln.Network.csproj" Private="false" />
    <!-- Instance data reads the game's items through Kiln.Items' internal face (kiln.items v4: InstanceGame.cs). Kiln.Items
         references only Kiln.Api, so there is no cycle. -->
    <ProjectReference Include="../Kiln.Items/Kiln.Items.csproj" Private="false" />
  </ItemGroup>
</Project>
