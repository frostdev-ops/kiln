<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.players: the managed face of native/services/players (who is on the server). Deployed to kiln/host/ and
       shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). Started by Kiln
       (ServiceTick.AutoStart: Kiln.PlayersStartup), which supplies identity.players (PlayerIdentity.cs). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- PlayerIdentity.cs over a fake roster, without a game. -->
    <InternalsVisibleTo Include="Kiln.Players.Tests" />
    <!-- Kiln.Network kicks for Players.Kick and enforces the ban list (it references this library, not the other way) -->
    <InternalsVisibleTo Include="Kiln.Network" />
    <InternalsVisibleTo Include="Kiln.Network.Tests" />
    <!-- the contract tests: the rows' names and the progression change events -->
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
  </ItemGroup>
</Project>
