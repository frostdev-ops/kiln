<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/ui (kiln.ui): Kiln windows (immediate mode over Dear ImGui), HUD text, toasts,
       key bindings (kiln/config/keybinds.json) and the Kiln menu. Client only; on a server every call is a no-op.
       Deployed to kiln/host/ and shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Ui.Tests" />
    <InternalsVisibleTo Include="Kiln.Ui.Preview" />
    <InternalsVisibleTo Include="Kiln.Admin" />
    <!-- the features a failed hook takes down, on a fake kiln.ui table -->
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
    <!-- Gems.AllowSockets widens the client's Gem Forge lists through GemForgeSockets.Widen -->
    <InternalsVisibleTo Include="Kiln.Abilities" />
    <!-- Kiln's own key bindings follow the language of Kiln's texts (KeyBinding.Description and Category, internal set) -->
    <InternalsVisibleTo Include="Kiln.Rules" />
    <InternalsVisibleTo Include="Kiln.Skills" />
    <InternalsVisibleTo Include="Kiln.Testing" />
    <InternalsVisibleTo Include="Kiln.DevTools" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Network/Kiln.Network.csproj" Private="false" />
    <!-- the Network tab's sync status (ContentSync) -->
    <ProjectReference Include="../Kiln.Content/Kiln.Content.csproj" Private="false" />
    <!-- Ui.Values' item views (ItemRarity) -->
    <ProjectReference Include="../Kiln.Items/Kiln.Items.csproj" Private="false" />
  </ItemGroup>
</Project>
