<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/ui (kiln.ui): Kiln windows (immediate mode over Dear ImGui), HUD text, toasts,
       key bindings (kiln/config/keybinds.json) and the Kiln menu. Client only; on a server every call is a no-op.
       Deployed to kiln/host/ and shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Network/Kiln.Network.csproj" Private="false" />
    <!-- the Network tab's sync status (ContentSync) -->
    <ProjectReference Include="../Kiln.Content/Kiln.Content.csproj" Private="false" />
  </ItemGroup>
</Project>
