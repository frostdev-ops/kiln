<Project Sdk="Microsoft.NET.Sdk">
  <!-- kiln.items: the managed face of native/services/items (give / take / read inventories, the item catalog).
       Deployed to kiln/host/ and shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime").
       Data/items.tsv (display names) is generated from the Enshrouded Save Editor's data/items.json, MIT, see Data/ITEMS-LICENSE.txt. -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- a block's tool wear rule is set as the block's mod (ToolWearRuntime) -->
    <InternalsVisibleTo Include="Kiln.Blocks" />
    <!-- the voxel material labels and game texts (ContentVoxelMaterials.cs) wait for the game's item list (GameItemTexts.Ready) -->
    <InternalsVisibleTo Include="Kiln.Content" />
    <InternalsVisibleTo Include="Kiln.Blocks.Tests" />
    <!-- Equip (EquipResult from a native result, the slot mapping, the capability verdict): pure parts tested offline. -->
    <InternalsVisibleTo Include="Kiln.Items.Tests" />
    <!-- the contract tests serve an older kiln.items table (the rows its v3 members name) -->
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
    <!-- Item instances (ItemInstances, ItemRecord, ItemInstanceInfo): instance data lives in Kiln.Saves. -->
    <InternalsVisibleTo Include="Kiln.Saves" />
    <InternalsVisibleTo Include="Kiln.Saves.Tests" />
    <!-- gems (Kiln.Abilities/Gems): a carrier's socket and a player's items read through the same item instances -->
    <InternalsVisibleTo Include="Kiln.Abilities" />
    <!-- the game's own names and item GUIDs (GameNames): the item icons (Kiln.Ui) -->
    <InternalsVisibleTo Include="Kiln.Ui" />
    <InternalsVisibleTo Include="Kiln.Ui.Tests" />
    <InternalsVisibleTo Include="Kiln.Stations.Tests" />
    <!-- the test kit names the upgrades' rolls (HarnessItems.SetUpgradeRolls: ItemUpgrades.Roller) -->
    <InternalsVisibleTo Include="Kiln.TestKit" />
    <!-- dev.32 TAME review: Kiln.Taming's attempts over the real ItemCosts on a made-up kiln.item_costs table; Kiln.Taming and
         Kiln.Pets submit their costs as Kiln services (ItemCosts.AsService: the receipt is theirs, whoever unloads) -->
    <InternalsVisibleTo Include="Kiln.Taming.Tests" />
    <InternalsVisibleTo Include="Kiln.Taming" />
    <InternalsVisibleTo Include="Kiln.Pets" />
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- player storage's client copy (since 0.2.0-dev.30.7): the channel kiln:storage, the players in game, a hosting game's
         own player (PlayerStorageMirror.cs) -->
    <ProjectReference Include="../Kiln.Network/Kiln.Network.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Players/Kiln.Players.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Client/Kiln.Client.csproj" Private="false" />
    <EmbeddedResource Include="Data/items.tsv" LogicalName="Kiln.Items.items.tsv" />
    <None Include="Data/ITEMS-LICENSE.txt" />
  </ItemGroup>
</Project>
