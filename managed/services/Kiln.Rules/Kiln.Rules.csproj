<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln.Rules: per-player rules from several mods, layered (scopes, owners, how values combine), applied by the native
       kiln.rules hooks (flight, placement, costs, mining) and by Kiln's other services (vitals: Kiln.Abilities and
       Kiln.Combat; water: Kiln.Items; persistence of builds: Kiln.Build). Deployed to kiln/host/ and shared by every mod. -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Rules.Tests" />
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Players/Kiln.Players.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Network/Kiln.Network.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Client/Kiln.Client.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Items/Kiln.Items.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Combat/Kiln.Combat.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Abilities/Kiln.Abilities.csproj" Private="false" />
    <ProjectReference Include="../Kiln.World/Kiln.World.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Gameplay/Kiln.Gameplay.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Build/Kiln.Build.csproj" Private="false" />
  </ItemGroup>
</Project>
