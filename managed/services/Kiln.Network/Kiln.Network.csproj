<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/net (kiln.net): mod channels, the join handshake and mod sync (Forge's
       SimpleChannel + FML handshake). Deployed to kiln/host/ and shared by every mod (mods reference it with
       Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- SteamGuardRelay calls Kiln.SteamGuard, marked KILNX002 until it is proven in a real client. -->
    <NoWarn>$(NoWarn);KILNX002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Players/Kiln.Players.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Client/Kiln.Client.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Network.Tests" />
    <InternalsVisibleTo Include="Kiln.Content" />
    <InternalsVisibleTo Include="Kiln.Ui" />
    <InternalsVisibleTo Include="NetTest" />
  </ItemGroup>
</Project>
