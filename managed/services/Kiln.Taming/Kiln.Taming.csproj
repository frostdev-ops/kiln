<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln.Taming (dev.32, dossier 19e): the taming framework. The game's own taming as mechanism (NativeTaming: what an
       animal's taming is now, its events, a server-side bait and pet step) and Kiln's own steps (selection tokens, replay,
       attempts, exact-cost receipts, timeouts, events); every policy (what a step costs, refunds, timeouts, retries, which
       creatures) is the mod's. Deployed to kiln/host/ and shared by every mod. docs/kiln/services/taming.md. -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AssemblyName>Kiln.Taming</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Taming.Tests" />
    <InternalsVisibleTo Include="Kiln.TestKit" />
    <!-- TamingBlock (Kiln.Blocks) registers its definitions as the block's mod and checks them by the engine's own rules -->
    <InternalsVisibleTo Include="Kiln.Blocks" />
    <InternalsVisibleTo Include="Kiln.Blocks.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <ProjectReference Include="../Kiln.World/Kiln.World.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Spawn/Kiln.Spawn.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Abilities/Kiln.Abilities.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Creatures/Kiln.Creatures.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Items/Kiln.Items.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Players/Kiln.Players.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Saves/Kiln.Saves.csproj" Private="false" />
    <ProjectReference Include="../Kiln.Pets/Kiln.Pets.csproj" Private="false" />
  </ItemGroup>
</Project>
