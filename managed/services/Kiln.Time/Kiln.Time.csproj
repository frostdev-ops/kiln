<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/time (kiln.time): time of day and weather re-roll. Deployed to kiln/host/ and
       shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- The weather (Weather.cs): name resolution, records from native ones, the result rule, tested offline. -->
    <InternalsVisibleTo Include="Kiln.Time.Tests" />
  </ItemGroup>
</Project>
