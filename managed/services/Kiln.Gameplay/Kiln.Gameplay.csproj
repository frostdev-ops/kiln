<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/gameplay (kiln.gameplay): player/world interaction events on Kiln's bus
       (crafting, interaction, loot, pickups, building, terraforming, teleports, natural spawns) and protection zones.
       Deployed to kiln/host/ and shared by every mod (mods reference it with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AssemblyName>Kiln.Gameplay</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Api.Tests" />
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- template names / kinds of the entity lifecycle events -->
    <ProjectReference Include="../Kiln.Spawn/Kiln.Spawn.csproj" Private="false" />
  </ItemGroup>
</Project>
