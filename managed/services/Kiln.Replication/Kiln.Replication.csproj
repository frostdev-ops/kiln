<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of native/services/repl (kiln.repl): the game's replication, read only, and on lab servers the
       loopback harness (ReplicationLab). Deployed to kiln/host/ and shared by every mod (mods reference it with
       Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Replication.Tests" />
  </ItemGroup>
</Project>
