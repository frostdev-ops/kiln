<Project Sdk="Microsoft.NET.Sdk">
  <!-- Managed face of the in-core service kiln.client (native/core/src/services/client.cpp): side, session state,
       local player and the client world's tick. Deployed to kiln/host/ and shared by every mod (mods reference it
       with Private="false" ExcludeAssets="runtime"). -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" Private="false" />
    <!-- GameInputSample.HeldKind is a Kiln.ActionKind -->
    <ProjectReference Include="../Kiln.Combat/Kiln.Combat.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- BuildingInputTests: the binding's layout (BuildingInputNative) against kiln_client.h -->
    <InternalsVisibleTo Include="Kiln.Api.Tests" />
    <!-- the test kit's kiln.client.crosshair fake (Fakes/Crosshair) mirrors CrosshairNative -->
    <InternalsVisibleTo Include="Kiln.TestKit" />
  </ItemGroup>
</Project>
