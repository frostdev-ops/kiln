<Project Sdk="Microsoft.NET.Sdk">
  <!-- A test mod of Kiln.TestKit.Tests with commands; its manifest is TkCommands.kiln.mod.json beside the assembly (the
       name Load<TMod> looks for first, so it flows into the test project's output without clashing). -->
  <ItemGroup>
    <ProjectReference Include="$(KilnManaged)services/Kiln.Chat/Kiln.Chat.csproj" Private="false" ExcludeAssets="runtime" />
    <None Include="TkCommands.kiln.mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
