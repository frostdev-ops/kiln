<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kiln.Sdk's tests: the bake (managed/Kiln.Sdk/bake, docs/kiln/modding/baked.md): its recorders in Kiln.Quests, Kiln.Skills and
       Kiln.Vfx, the files it writes, and mods/tests/bake-test built with it, whose baked files are compared with what its code
       defines when it runs. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- not Kiln.Sdk.*: the tests use the bake's own namespace -->
    <RootNamespace>Kiln.SdkTests</RootNamespace>
    <!-- the harness as in the game (Kiln.Host runs with invariant globalization) -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- the bake and, through it, Kiln.TestKit, Kiln.Host and every service beside them (as in kiln/host) -->
    <ProjectReference Include="../../Kiln.Sdk/bake/Kiln.Sdk.Bake.csproj" />
    <!-- built with the bake step, never referenced: bake-test.txt names its output folder -->
    <KilnBakeMod Include="../../../mods/tests/bake-test/BakeTest.csproj" />
    <ProjectReference Include="@(KilnBakeMod)" ReferenceOutputAssembly="false" />
    <!-- mods the tests make folders of (a plain library: building it never bakes); bake-fixtures.txt names the assembly -->
    <KilnBakeFixtures Include="Fixtures/BakeFixtures.csproj" />
    <ProjectReference Include="@(KilnBakeFixtures)" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Fixtures/**" />
    <None Remove="Fixtures/**" />
    <!-- BakeTargetsTests runs its targets on a stub project -->
    <None Include="../../Kiln.Sdk/Sdk/Kiln.Bake.targets" Link="Kiln.Bake.targets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="WriteBakeModPath" AfterTargets="Build">
    <MSBuild Projects="@(KilnBakeMod)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_KilnBakeModTarget" />
    </MSBuild>
    <WriteLinesToFile File="$(OutDir)bake-test.txt" Lines="@(_KilnBakeModTarget->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <MSBuild Projects="@(KilnBakeFixtures)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_KilnBakeFixturesTarget" />
    </MSBuild>
    <WriteLinesToFile File="$(OutDir)bake-fixtures.txt" Lines="@(_KilnBakeFixturesTarget->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
