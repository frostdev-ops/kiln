<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of Kiln.Testing's guided check runner: discovery and order, the ledger (append, reread, a corrupt file
       moved aside, a write cut between the temporary file and the rename), scrubbing, the cheats rule's refusal matrix
       with a fake guard, and the runner's flow. The lab part is mods/tests/client-check-test/fixtures/lab.sh. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" />
    <ProjectReference Include="../../Kiln.Testing/Kiln.Testing.csproj" />
    <ProjectReference Include="../../services/Kiln.Client/Kiln.Client.csproj" />
    <ProjectReference Include="../../services/Kiln.Network/Kiln.Network.csproj" />
    <ProjectReference Include="../../services/Kiln.Ui/Kiln.Ui.csproj" />
  </ItemGroup>
</Project>
