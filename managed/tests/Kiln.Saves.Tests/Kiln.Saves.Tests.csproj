<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EntityTableSource Condition="'$(EntityTableSource)' == ''">../../services/Kiln.Saves/Entities.cs</EntityTableSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Exercise the production identity/matching code with a deterministic world; no game or service mocks at ABI level. -->
    <Compile Include="$(EntityTableSource)" Link="Entities.cs" />
  </ItemGroup>
</Project>
