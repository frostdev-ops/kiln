<Project Sdk="Microsoft.NET.Sdk">
  <!-- A mod-like consumer compiled against the dev.24 shape of Kiln.Game (Dev24Shape, through the extern alias dev24,
       the only way a mod can name Kiln.GameTypes) and run by LegacyBinaryTests against the Kiln.Game under test. -->
  <PropertyGroup>
    <AssemblyName>Kiln.Game.LegacyConsumer</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dev24Shape/Dev24Shape.csproj" Private="false" PrivateAssets="all" Aliases="dev24" />
    <ProjectReference Include="../../../../../Kiln.Api/Kiln.Api.csproj" Private="false" />
  </ItemGroup>
</Project>
