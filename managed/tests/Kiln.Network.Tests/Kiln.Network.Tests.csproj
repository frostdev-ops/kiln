<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of Kiln.Network's plain decisions (what happens to a client without Kiln). The protocol and the gate's
       transport half are tested by tools/nettest against a lab server. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- SteamMessagesTests: a fake kiln.net table ([UnmanagedCallersOnly] functions, its layout) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;KILNX002</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Kiln.Api/Kiln.Api.csproj" />
    <ProjectReference Include="../../services/Kiln.Players/Kiln.Players.csproj" />
    <ProjectReference Include="../../services/Kiln.Client/Kiln.Client.csproj" />
    <ProjectReference Include="../../services/Kiln.Network/Kiln.Network.csproj" />
    <!-- Kiln.Host beside it, as in kiln/host: BootGateTests read its boot fingerprints through BootGate's reflection seam. Not on the
         service autostart list, so loading it starts nothing. -->
    <ProjectReference Include="../../Kiln.Host/Kiln.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The admin commands' tick-thread hop after a guard request (SteamGuardRelayTests drives it on a real scheduler). -->
    <Compile Include="../../../mods/Kiln.Admin/OpsTick.cs" Link="AdminOpsTick.cs" />
    <!-- Who may drive lab bot players over labbot:control (LabBotControlPeersTests): lab peers only. -->
    <Compile Include="../../../mods/tests/labbot-test/ControlPeers.cs" Link="LabBotControlPeers.cs" />
    <!-- Which connections labbot-test lets in as bots when kiln.net would refuse a client without Kiln (LabBotPeersTests). -->
    <Compile Include="../../../mods/tests/labbot-test/BotPeers.cs" Link="LabBotPeers.cs" />
    <!-- Every labbot:control request gets an answer, an error when its op threw (LabBotRepliesTests). -->
    <Compile Include="../../../mods/tests/labbot-test/Replies.cs" Link="LabBotReplies.cs" />
  </ItemGroup>
</Project>
