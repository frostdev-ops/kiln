<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Kiln.TestKit NuGet package: mod tests under `dotnet test`, with no game. Packed from the assemblies a build of
       managed/Kiln.TestKit put into $(KilnTestKitStage) (never Kiln.Sdk's mdk-stage: Kiln.Api.Ref.csproj packs every
       Kiln.*.dll there into Kiln.Api's kiln/lib).
         lib/net10.0/   Kiln.TestKit.dll + Kiln.Host.dll (the kit loads mods through Kiln.Host's loader; run time only)
         ref/net10.0/   Kiln.TestKit.dll + XML docs (what a test project compiles against: Kiln.Host stays out of sight)
         build/         Kiln.TestKit.props (the version) and Kiln.TestKit.targets: Kiln.Testing and every Kiln.<Service>.dll
                        from the Kiln.Api package of the same version (kiln/lib), copied into the test output beside
                        Kiln.Host; and a referenced mod project's kiln.mod.json and files carried beside its assembly.
       Dependencies: Kiln.Api [same version] (lib/Kiln.Api.dll, kiln/lib), xunit.v3.extensibility.core 3.1.0.
       Restoring this project needs the feed that holds that Kiln.Api (pack-with-testkit.sh passes it). -->
  <Import Project="../../Kiln.Sdk/Sdk/Kiln.Version.props" />
  <PropertyGroup>
    <PackageId>Kiln.TestKit</PackageId>
    <Version>$(KilnSdkVersion)</Version>
    <Title>Kiln test kit</Title>
    <Authors>Kiln contributors</Authors>
    <Description>Kiln (Enshrouded mod framework) test kit: load a mod through Kiln's real loader under dotnet test, with no game, step its ticks, run commands, join fake players, and run its [KilnTest] methods as xunit tests. Docs: docs/kiln/modding/unit-tests.md.</Description>
    <PackageTags>kiln;enshrouded;mod;testing;xunit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- NU5100: Kiln.Host.dll in lib/ without a ref/ twin is meant (run time only); NU5128: no build output. -->
    <NoWarn>$(NoWarn);NU5100;NU5128;NU5131</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Dependencies of the package only: this project compiles nothing. -->
    <PackageReference Include="Kiln.Api" Version="[$(KilnSdkVersion)]" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(KilnTestKitStage)/Kiln.TestKit.dll;$(KilnTestKitStage)/Kiln.Host.dll" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="$(KilnTestKitStage)/Kiln.TestKit.dll;$(KilnTestKitStage)/Kiln.TestKit.xml" Pack="true" PackagePath="ref/net10.0/" />
    <None Include="build/Kiln.TestKit.targets" Pack="true" PackagePath="build/" />
    <None Include="$(IntermediateOutputPath)Kiln.TestKit.props" Pack="true" PackagePath="build/" />
  </ItemGroup>
  <!-- build/Kiln.TestKit.props: the version, so the targets find the Kiln.Api package of the same pack. -->
  <Target Name="KilnTestKitProps" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <WriteLinesToFile File="$(IntermediateOutputPath)Kiln.TestKit.props" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;;  &lt;!-- generated by Kiln.TestKit.Pack.csproj --&gt;;  &lt;PropertyGroup&gt;;    &lt;KilnTestKitVersion&gt;$(KilnSdkVersion)&lt;/KilnTestKitVersion&gt;;  &lt;/PropertyGroup&gt;;&lt;/Project&gt;" />
  </Target>
  <Target Name="KilnTestKitCheckStage" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(KilnTestKitStage)' == '' or !Exists('$(KilnTestKitStage)/Kiln.TestKit.dll') or !Exists('$(KilnTestKitStage)/Kiln.Host.dll') or !Exists('$(KilnTestKitStage)/Kiln.TestKit.xml')"
           Text="KilnTestKitStage must point at a Release build of managed/Kiln.TestKit with its XML docs (Kiln.TestKit.dll, .xml, Kiln.Host.dll)" />
  </Target>
</Project>
