<Project Sdk="Microsoft.NET.Sdk">
  <!-- Code fixes for Kiln.Analyzers (KILN1xx). IDE-only: references Workspaces, so it is a separate assembly. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Kiln.Analyzers.CodeFixes</AssemblyName>
    <RootNamespace>Kiln.Analyzers</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" PrivateAssets="all" />
    <ProjectReference Include="../Kiln.Analyzers.csproj" />
  </ItemGroup>
</Project>
