<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of Kiln.Analyzers (KILN1xx) and its code fixes: each test compiles a small mod against the real Kiln.Api and
       service assemblies (copied next to the tests by the project references) and runs one analyzer over it. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kiln.Analyzers/Kiln.Analyzers.csproj" />
    <ProjectReference Include="../../src/Kiln.Analyzers/CodeFixes/Kiln.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="../../../Kiln.Api/Kiln.Api.csproj" />
    <ProjectReference Include="../../../Kiln.Testing/Kiln.Testing.csproj" />
    <ProjectReference Include="../../../services/Kiln.Chat/Kiln.Chat.csproj" />
    <ProjectReference Include="../../../services/Kiln.Players/Kiln.Players.csproj" />
    <ProjectReference Include="../../../services/Kiln.Combat/Kiln.Combat.csproj" />
    <ProjectReference Include="../../../services/Kiln.Hooks/Kiln.Hooks.csproj" />
    <ProjectReference Include="../../../services/Kiln.World/Kiln.World.csproj" />
    <ProjectReference Include="../../../services/Kiln.Spawn/Kiln.Spawn.csproj" />
    <ProjectReference Include="../../../services/Kiln.Blocks/Kiln.Blocks.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- what the KilnManifest task works out from a mod's data files, against Kiln.Blocks' block types (DataClientsTests) -->
    <Compile Include="../../../Kiln.Sdk/DataClients.cs" Link="Shared/DataClients.cs" />
  </ItemGroup>
</Project>
