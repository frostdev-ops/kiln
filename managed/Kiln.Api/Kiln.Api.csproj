<Project Sdk="Microsoft.NET.Sdk">
  <!-- The API mods compile against. Loaded once into the default load context and shared by every mod. -->
  <PropertyGroup>
    <RootNamespace>Kiln</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Host" />
    <InternalsVisibleTo Include="Kiln.Host.Tests" />
    <InternalsVisibleTo Include="Kiln.Contract.Tests" />
    <InternalsVisibleTo Include="Kiln.Network.Tests" />
    <InternalsVisibleTo Include="Kiln.Blocks.Tests" />
    <InternalsVisibleTo Include="Kiln.World.Tests" />
    <InternalsVisibleTo Include="Kiln.Items.Tests" />
    <InternalsVisibleTo Include="Kiln.TestKit" />
    <!-- Kiln's own service assemblies (managed/services/*) use the native service access in Services/. -->
    <InternalsVisibleTo Include="Kiln.World" />
    <InternalsVisibleTo Include="Kiln.Players" />
    <InternalsVisibleTo Include="Kiln.Chat" />
    <InternalsVisibleTo Include="Kiln.Time" />
    <InternalsVisibleTo Include="Kiln.Items" />
    <InternalsVisibleTo Include="Kiln.Spawn" />
    <InternalsVisibleTo Include="Kiln.Settings" />
    <InternalsVisibleTo Include="Kiln.Admin" />
    <InternalsVisibleTo Include="Kiln.Example" />
    <!-- Services -->
    <InternalsVisibleTo Include="Kiln.Combat" />
    <InternalsVisibleTo Include="Kiln.Gameplay" />
    <InternalsVisibleTo Include="Kiln.Saves" />
    <InternalsVisibleTo Include="Kiln.Data" />
    <InternalsVisibleTo Include="Kiln.Content" />
    <InternalsVisibleTo Include="Kiln.Hooks" />
    <InternalsVisibleTo Include="Kiln.Game" />
    <InternalsVisibleTo Include="Kiln.Permissions" />
    <InternalsVisibleTo Include="Kiln.Testing" />
    <InternalsVisibleTo Include="Kiln.Client" />
    <InternalsVisibleTo Include="Kiln.Ui" />
    <InternalsVisibleTo Include="Kiln.Network" />
    <!-- More services -->
    <InternalsVisibleTo Include="Kiln.Assets" />
    <InternalsVisibleTo Include="Kiln.Build" />
    <InternalsVisibleTo Include="Kiln.Emf" />
    <InternalsVisibleTo Include="Kiln.Abilities" />
    <InternalsVisibleTo Include="Kiln.Creatures" />
    <InternalsVisibleTo Include="Kiln.Skills" />
    <InternalsVisibleTo Include="Kiln.Audio" />
    <InternalsVisibleTo Include="Kiln.Vfx" />
    <InternalsVisibleTo Include="Kiln.Quests" />
    <InternalsVisibleTo Include="Kiln.Rules" />
    <InternalsVisibleTo Include="Kiln.PlayerAnim" />
    <InternalsVisibleTo Include="Kiln.Blocks" />
    <!-- dev.28: the libraries its packages add, and their unit test projects. Reserved here once, so that no two
         packages edit this list. A line whose assembly did not ship is removed at the wave's end. -->
    <InternalsVisibleTo Include="Kiln.Queries" />
    <InternalsVisibleTo Include="Kiln.Camera" />
    <InternalsVisibleTo Include="Kiln.Markers" />
    <InternalsVisibleTo Include="Kiln.ModValues" />
    <InternalsVisibleTo Include="Kiln.Replication" />
    <InternalsVisibleTo Include="Kiln.Mounts" />
    <InternalsVisibleTo Include="Kiln.Pets" />
    <InternalsVisibleTo Include="Kiln.Terrain" />
    <InternalsVisibleTo Include="Kiln.ClientOptions" />
    <InternalsVisibleTo Include="Kiln.SlotUi" />
    <InternalsVisibleTo Include="Kiln.Queries.Tests" />
    <InternalsVisibleTo Include="Kiln.Camera.Tests" />
    <InternalsVisibleTo Include="Kiln.Markers.Tests" />
    <InternalsVisibleTo Include="Kiln.ModValues.Tests" />
    <InternalsVisibleTo Include="Kiln.Replication.Tests" />
    <InternalsVisibleTo Include="Kiln.Mounts.Tests" />
    <InternalsVisibleTo Include="Kiln.Pets.Tests" />
    <InternalsVisibleTo Include="Kiln.Terrain.Tests" />
    <InternalsVisibleTo Include="Kiln.ClientOptions.Tests" />
    <InternalsVisibleTo Include="Kiln.SlotUi.Tests" />
  </ItemGroup>
</Project>
