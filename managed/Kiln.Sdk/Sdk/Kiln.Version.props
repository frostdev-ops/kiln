<Project>
  <!-- One place for the MDK version. KilnSdkVersion here is the base (major.minor.patch): the packages carry the full version,
       which managed/Kiln.Sdk/pack.sh passes in (KILN_SDK_VERSION: a release's, e.g. 0.2.0-dev.12; else a unique local one,
       <base>-dev.local.<date>.<time>), and the copy of this file inside Kiln.Sdk says that version, so a mod restores the
       Kiln.Api of the same pack. KilnModApiVersion must match Kiln.Mods.ApiVersion (major.minor) in managed/Kiln.Api/Mods.cs;
       templates/*/.template.config/template.json default to the base, and pack.sh writes the full version into the packed ones. -->
  <PropertyGroup>
    <KilnSdkVersion>0.2.0</KilnSdkVersion>
    <KilnModApiVersion>0.2</KilnModApiVersion>
  </PropertyGroup>
</Project>
