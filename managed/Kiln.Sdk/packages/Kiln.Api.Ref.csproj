<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Kiln.Api NuGet package mods compile against: lib/net10.0/Kiln.Api.dll (+ XML docs) and, not referenced by
       default, kiln/lib/Kiln.<Service>.dll + Kiln.Testing.dll (Kiln.Sdk references the ones a mod lists in
       KilnServices). Packed by managed/Kiln.Sdk/pack.sh from the assemblies it stages in $(KilnStage). -->
  <Import Project="../Sdk/Kiln.Version.props" />
  <PropertyGroup>
    <PackageId>Kiln.Api</PackageId>
    <Version>$(KilnSdkVersion)</Version>
    <Description>Kiln (Enshrouded mod framework) API for mods: Kiln.Api and the shared service assemblies. Use with Kiln.Sdk.</Description>
    <PackageTags>kiln;enshrouded;mod</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU5100;NU5128;NU5131</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(KilnStage)/Kiln.Api.dll;$(KilnStage)/Kiln.Api.xml" Pack="true" PackagePath="lib/net10.0/" />
    <None Include="$(KilnStage)/Kiln.*.dll" Exclude="$(KilnStage)/Kiln.Api.dll;$(KilnStage)/Kiln.Host.dll;$(KilnStage)/Kiln.Sdk.Tasks.dll" Pack="true" PackagePath="kiln/lib/" />
    <None Include="$(KilnStage)/Kiln.*.xml" Exclude="$(KilnStage)/Kiln.Api.xml" Pack="true" PackagePath="kiln/lib/" />
  </ItemGroup>
  <!-- kiln/lib/Kiln.Services.props: which service assemblies each service compiles against (its ProjectReferences),
       so Kiln.Sdk references the whole closure of a mod's KilnServices (Content needs Items, ...). -->
  <ItemGroup>
    <_KilnSvcProj Include="$(MSBuildThisFileDirectory)../../services/*/*.csproj" />
    <None Include="$(IntermediateOutputPath)Kiln.Services.props" Pack="true" PackagePath="kiln/lib/" />
  </ItemGroup>
  <Target Name="KilnServiceDeps" BeforeTargets="_GetPackageFiles;GenerateNuspec">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_KilnOneServiceDeps" Properties="KilnSvcProj=%(_KilnSvcProj.FullPath);KilnSvcName=%(_KilnSvcProj.Filename)">
      <Output TaskParameter="TargetOutputs" ItemName="_KilnSvcDepLine" />
    </MSBuild>
    <WriteLinesToFile File="$(IntermediateOutputPath)Kiln.Services.props" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;;  &lt;!-- generated by Kiln.Api.Ref.csproj: service -> the services it compiles against --&gt;;  &lt;ItemGroup&gt;;@(_KilnSvcDepLine);  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
  </Target>
  <Target Name="_KilnOneServiceDeps" Returns="@(_KilnLine)">
    <XmlPeek XmlInputPath="$(KilnSvcProj)" Query="/Project/ItemGroup/ProjectReference/@Include">
      <Output TaskParameter="Result" ItemName="_KilnRef" />
    </XmlPeek>
    <PropertyGroup>
      <_KilnSvc>$(KilnSvcName.Substring(5))</_KilnSvc>
    </PropertyGroup>
    <ItemGroup>
      <_KilnDepName Include="$([System.Text.RegularExpressions.Regex]::Match('%(_KilnRef.Identity)', 'Kiln\.([A-Za-z0-9]+)\.csproj').Groups[1].Value)" />
      <_KilnDepName Remove="Api;Host;Testing;Game" />
      <_KilnLine Include="    &lt;_KilnServiceDep Include=&quot;%(_KilnDepName.Identity)&quot; Service=&quot;$(_KilnSvc)&quot; /&gt;" Condition="'@(_KilnDepName)' != ''" />
    </ItemGroup>
  </Target>
  <Target Name="KilnCheckStage" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(KilnStage)' == '' or !Exists('$(KilnStage)/Kiln.Api.dll')" Text="KilnStage must point at built Kiln assemblies (use managed/Kiln.Sdk/pack.sh)" />
  </Target>
</Project>
