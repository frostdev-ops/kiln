{
  "format": 1,
  "side": "client",
  "extends": "server.d/assets.json",
  "comment": "Client 26404966: every server.d/assets.json pattern matches unchanged. Adds the UI texture cache's populate (called every UI frame from the UI update; it returns at once while byte +uitex.populated is 1, else it lists every keen::UiTextureResource through the resource service (cache +uitex.resources = S) and inserts each unknown key into the cache's key map at +uitex.map, then sets the byte). kiln.assets resets the byte after it registers an icon so the cache learns the new key at its next frame.",
  "symbols": {
    "assets/UiTexturePopulate": {
      "find": [
        {
          "pattern": "40 55 48 83 EC 40 80 B9 {assets/uitex.populated:d32} 01 48 8B E9 0F 84 ?? ?? ?? ?? 48 8B 51 {assets/uitex.resources:d8} 45 33 C9 44 8B 05 ?? ?? ?? ?? 48 8D 4C 24 20 E8"
        }
      ]
    },
    "@assets/UiTexturePopulate.fields": {
      "find": [
        {
          "scope": {
            "symbol": "assets/UiTexturePopulate",
            "size": 256
          },
          "pattern": "48 8D BD {assets/uitex.map:d32} 66 90 48 8B D3 48 8B CF E8"
        }
      ]
    },
    "@assets/UiTextureAlloc.fields": {
      "find": [
        {
          "pattern": "48 83 EC 28 48 8B 91 {assets/uitex.free_count:d32} 48 85 D2 74 ?? 48 8D 42 FF 48 89 81 {assets/uitex.free_count:d32} 48 8B 81 ?? ?? 00 00 8B 44 90 FC"
        }
      ]
    }
  },
  "constants": {
    "assets/uitex.populated": {
      "min_votes": 1
    },
    "assets/uitex.resources": {
      "min_votes": 1
    },
    "assets/uitex.map": {
      "min_votes": 1
    },
    "assets/uitex.free_count": {
      "min_votes": 2
    }
  },
  "features": {
    "assets.ui_icons": {
      "symbols": [
        "assets/UiTexturePopulate"
      ],
      "constants": [
        "assets/uitex.populated",
        "assets/uitex.resources",
        "assets/uitex.map",
        "assets/uitex.free_count"
      ]
    }
  }
}
