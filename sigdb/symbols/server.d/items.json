    "items/AddComponent": {
      "comment": "adds a component to an existing entity outside a program: (world*, u32 entity, u32 hash, {void*, u64 size}* data). The rename handler calls it for a chest's first name. Lab use only (docs/re/items.md section 14). Server 26430253 0x5fc570",
      "find": [
        { "pattern": "48 83 EC 38 41 0F 10 01 48 81 C1 ?? ?? ?? ?? 4C 8D 4C 24 20 0F 29 44 24 20 E8 ?? ?? ?? ?? 48 83 C4 38 C3" }
