        { "scope": { "symbol": "items/SetString", "size": 512 }, "pattern": "4C 8B 9D {items/strings.keys:d32} 4F 39 04 CB" },
        { "scope": { "symbol": "items/SetString", "size": 512 }, "pattern": "48 8B 85 {items/strings.values:d32} 48 8B 3C F8 83 87 38 01 00 00 FF" }
