    "items/MoveAll": {
      "comment": "move all (shroudlink hook point `move_all`): (Result12* out, tx, u32 from, u32 to, u32 mode, u8 flag). Server 26430253 0x1b3fb0",
      "find": [
        { "pattern": "48 89 4C 24 08 55 53 56 57 41 54 41 56 48 8D AC 24 A8 FC FF FF" }
      ]
    },
    "items/SetString": {
      "comment": "stores a custom string (a chest's name) in the game's string table: (out, CustomPlayerStringsSystem*, u64 oldId, {char*, u64 len}*) -> id = FNV-1a 64 of the text at out+8. Server 26430253 0x915b80 (shroudlink hook point `set_string`)",
      "find": [
        { "pattern": "48 89 5C 24 10 55 56 57 41 54 41 57 48 83 EC 30 4D 8B 59 08" }
      ]
    },
    "@items/SetString.fields": {
      "comment": "the string table's HashMap (the same type as the item registry's): bitmap, capacity, count, keys, values, as set_string's own lookup reads them",
      "find": [
