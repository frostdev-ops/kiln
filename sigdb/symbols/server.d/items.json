    "@items/FuelWrite.site": {
      "comment": "actor_interaction's TransferFuelEvent: the job's write flag, its tracker and storage, then the tracked other-entity write of Fuel (docs/re/items.md section 12)",
      "find": [
        { "pattern": "E8 {items/JobWriteFlag:rel32} 49 8B 4D 00 0F B6 D8 E8 {items/JobTracker:rel32} 49 8B 4D 00 48 8B F8 E8 {items/JobStorage:rel32} 4C 8B CE 88 5C 24 28 4C 8B C7 44 89 74 24 20 48 8B D0 48 8D 8D ?? ?? 00 00 E8 {items/WriteOther:rel32}" }
      ]
