    "items/EquipItem": {
      "comment": "the game's equip (EMF's equipItem): (Result12* out, tx, u64 inventorySlotId, u8 keen::EquipmentSlot) moves the stack in that slot into the equipment slot of the program's current entity (the player: ProgramContext +8, not the transaction's operator), inside the transaction; an EquipmentSlot of 24 or more lets the item pick its own slot. Error 0 ok, 0x11 refused (the item's EquipmentSlotType is not the slot's, or a move failed), 0x15 no item there, 0x1f the current entity has no SlotSelection or InventorySetup, or no free slot. Server 26430253 0x1b4e70, client 26430625 0x4152d0 (docs/re/items.md section 16)",
      "find": [
        { "pattern": "44 88 4C 24 20 48 89 54 24 10 48 89 4C 24 08 55 56 41 54 41 55 41 56 48 8D AC 24 30 FF FF FF 48 81 EC D0 01 00 00 48 8B F2 4C 8B E1" }
      ]
    },
    "items/UnequipItem": {
      "comment": "the game's unequip: (Result12* out, tx, u64 inventorySlotId, u8 keen::EquipmentSlot) moves what the current entity's equipment slot holds into a free Generic slot of its inventory (an EquipmentSlot of 24 or more: the equipment slot that holds inventorySlotId). Error codes as items/EquipItem. Server 26430253 0x1b9b80, client 26430625 0x419740",
      "find": [
        { "pattern": "4C 89 44 24 18 53 55 56 41 55 41 56 41 57 48 83 EC 78 4C 8B FA 48 8B F1 48 8D 94 24 B8 00 00 00 41 0F B6 E9 49 8B D8 49 8B 0F E8" }
      ]
    },
    "@items/EquipAction.calls": {
      "comment": "equipment_actions' handler of a client's changeEquipmentAction (server 26430253 0x144950): type 1 calls unequip, type 0 equip, both with (out, tx, action.inventorySlotId, action.equipmentSlot). A second vote for both symbols, and the evidence that they are what a player's own equip runs",
      "find": [
        { "pattern": "0F B6 8B ?? ?? 00 00 85 C9 74 ?? 83 F9 01 75 ?? 44 0F B6 8B ?? ?? 00 00 48 8D 55 ?? 4C 8B 83 ?? ?? 00 00 48 8D 8D ?? ?? 00 00 E8 {items/UnequipItem:rel32} EB ?? 44 0F B6 8B ?? ?? 00 00 48 8D 55 ?? 4C 8B 83 ?? ?? 00 00 48 8D 8D ?? ?? 00 00 E8 {items/EquipItem:rel32} 40 38 30" }
      ]
    }
