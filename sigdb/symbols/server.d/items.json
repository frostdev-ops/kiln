    "items/SlotTransfer": {
      "comment": "the game's slot transfer (EMF moveStack, shroudlink `transfer`): (Result12* out, tx, u64 dst, u64 src, i32 mode) moves a stack (mode 0), half (1) or one item (2) between two slots inside the transaction, the item entity with it. Server 26430253 0x1b4550; one of the calls inside quick stack (docs/re/items.md section 13)",
      "find": [
        { "pattern": "48 89 5C 24 18 55 56 57 41 56 41 57 48 8B EC 48 81 EC 80 00 00 00 49 8B D9 49 8B F8 4C 8B FA 48 8B F1 45 3B C1 75 1F" }
      ]
    },
    "items/QuickStack": {
      "comment": "quick stack (shroudlink hook point `quick_stack`, MIT; a player's R key and, once per chest, a Quick Stack Station): (Result12* out, tx, u32 to, u32 from, feedback*). Server 26430253 0x1b3830",
      "find": [
        { "pattern": "48 89 5C 24 18 48 89 4C 24 08 55 56 57 41 54 41 55 41 56 41 57 48 8D AC 24 20 FE FF FF 48 81 EC E0 02 00 00 48 8B 72 18" }
      ]
    },
    "items/AreaDeposit": {
      "comment": "the Quick Stack Station's deposit (shroudlink hook point `area_deposit`): calls quick stack once per chest in range. Checked, not hooked. Server 26430253 0x1b2a70",
      "find": [
        { "pattern": "48 89 5C 24 18 48 89 4C 24 08 55 56 57 41 54 41 55 41 56 41 57 48 8D AC 24 20 FE FF FF 48 81 EC E0 02 00 00 4C 8B FA" }
