    "@items/CreateEntity.next_id": {
      "comment": "createEntity called with id 0 takes the next entity id from the entity storage's counter (lock xadd, +1): the stamps of items.instances rely on that counter only growing within a world (docs/kiln/services/items.md, 'Item instances'). Server 26430253 0x6247be",
      "find": [
        {
          "scope": { "symbol": "spawn/CreateEntity", "size": 4096 },
          "pattern": "B8 01 00 00 00 F0 41 0F C1 84 24 {items/storage.next_id:d32} FF C0"
        }
      ]
    },
    "@items/QueueSetup.next_id": {
      "comment": "the entity storage's setup gives every job command queue (stride 0x40) a pointer to that same counter, so the queued creates (createPide's item entities) take their ids from it as well. Server 26430253 0x62d556",
      "find": [
        { "pattern": "4C 8D AF {items/storage.next_id:d32} 0F 1F 00 0F B6 47 08 45 33 C9 48 8B 9F ?? ?? ?? ?? BA 00 00 10 00 41 B8 40 00 00 00 C6 44 24 20 00 48 8B CE 4A 89 74 33 08 42 88 44 33 2C 48 8B 06 FF 50 08 4A 89 44 33 10 49 FF C7 4A C7 44 33 18 00 00 10 00 4E 89 6C 33 {items/queue.next_id:d8}" }
