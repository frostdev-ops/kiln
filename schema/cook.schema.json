{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cook.schema.json",
  "title": "Kiln cook recipe (assets/cook.json, impact/cook.json), format 1",
  "description": "How a mod's game-derived files are made on the player's machine from the installed game (mods ship sources and a recipe, never game data). assets/cook.json holds model steps (tools/modelcook: op model, visual) sound steps (tools/soundcook: op sound, cue, voiceover) and animation steps (tools/animcook: op skeleton, clips, graph); each step's cooker is its own \"tool\", else the file's \"tool\", else modelcook. impact/cook.json (\"tool\": \"impact\") holds Impact programs (tools/impact). Every cooker reads the file with Python's json module: plain JSON, no comments, no trailing commas. Docs: docs/kiln/modding/models.md#cookjson-format-1, docs/kiln/modding/sounds.md, docs/kiln/modding/animations.md, docs/kiln/modding/impact.md.",
  "type": "object",
  "required": ["format"],
  "properties": {
    "format": { "const": 1 },
    "tool": { "enum": ["modelcook", "soundcook", "animcook", "impact"], "default": "modelcook", "description": "The default cooker of the steps (absent: modelcook)." }
  },
  "if": { "properties": { "tool": { "const": "impact" } }, "required": ["tool"] },
  "then": { "$ref": "#/$defs/impact" },
  "else": { "$ref": "#/$defs/assetsRecipe" },
  "$defs": {
    "guid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", "x-kiln-message": "a GUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)[\\s\\S]+$",
      "x-kiln-message": "a path relative to this recipe",
      "x-kiln-file": "self"
    },
    "game": {
      "type": "object",
      "description": "Informational: the side and build the recipe was written on.",
      "properties": { "side": { "enum": ["client", "server"] }, "madeOn": { "type": "string" } }
    },
    "modPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)[\\s\\S]+$",
      "x-kiln-message": "a path relative to the mod's folder",
      "x-kiln-file": "mod"
    },
    "attach": {
      "type": "string",
      "anyOf": [ { "pattern": "^[A-Za-z][A-Za-z0-9]*$" }, { "pattern": "^[jJ][0-9]+$" } ],
      "description": "A rigid model on one joint: a slot of the skeleton (Head, Chest, HandPalmR, ...) or j<index>. The mesh has no skin; its origin is the joint."
    },
    "inputRef": { "type": "string", "pattern": "^@.+$", "description": "@<input id>: that input's GUID." },
    "guidOrInput": { "anyOf": [{ "$ref": "#/$defs/guid" }, { "$ref": "#/$defs/inputRef" }], "x-kiln-message": "a GUID or @<input id>" },
    "materialRef": { "anyOf": [{ "$ref": "#/$defs/guid" }, { "$ref": "#/$defs/inputRef" }, { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }], "x-kiln-message": "a GUID, @<input id>, or the name of a material in this mod's blocks/*.json" },
    "input": {
      "type": "object",
      "required": ["guid", "type"],
      "properties": {
        "comment": {},
        "guid": { "$ref": "#/$defs/guid", "x-kiln-ref": "resources", "x-kiln-ref-forms": ["guid"], "x-kiln-ref-missing": "error" },
        "type": { "type": "string", "minLength": 1 },
        "part": { "type": "integer", "minimum": 0, "default": 0 }
      },
      "x-kiln-unknownKeys": "warning"
    },
    "assetsRecipe": {
      "type": "object",
      "description": "assets/cook.json: model, sound and animation steps.",
      "properties": {
        "format": {},
        "comment": {},
        "tool": {},
        "out": { "type": "string", "minLength": 1, "default": "cooked", "description": "Output folder, relative to cook.json (gitignored)." },
        "manifest": { "$ref": "#/$defs/path", "default": "assets.json", "description": "soundcook: the kiln.assets manifest it updates." },
        "mod": { "type": "string", "minLength": 1, "description": "animcook and skinned models: the mod id in the ids of what it makes. Default: the id in the nearest kiln.mod.json." },
        "game": { "$ref": "#/$defs/game" },
        "guidNamespace": { "$ref": "#/$defs/guid", "description": "soundcook: GUIDs of new sounds are UUIDv5(namespace, \"<op>:<name>\"); pick it once, never change it." },
        "blockSounds": { "type": "array", "items": { "type": "string" }, "description": "soundcook: the steps `soundcook.py blocks` wrote from the sound blocks of blocks/*.json; it replaces them on its next run. Leave it to the tool." },
        "voiceoverFallback": { "anyOf": [{ "$ref": "#/$defs/voLang" }, { "type": "null" }], "description": "soundcook: the mod-wide default for empty voice slots (null / absent: silence, as the game)." },
        "inputs": {
          "type": "object",
          "description": "Vanilla inputs read from the installed game: id -> {guid, type, part}.",
          "additionalProperties": {
            "$ref": "#/$defs/input",
            "properties": {
              "type": {
                "enum": ["keen::RenderModel", "keen::ecs::TemplateResource", "keen::RenderMaterialResource", "keen::SoundResource", "keen::SoundContainerResource", "keen::VoiceoverResource", "keen::ModelHierarchyResource", "keen::JointAnimation", "keen::anim_graph::runtime_graph::AnimationGraphResource2_0"],
                "x-kiln-severity": "warning",
                "x-kiln-message": "model steps use keen::RenderModel / keen::ecs::TemplateResource / keen::RenderMaterialResource inputs, sound steps keen::SoundResource / SoundContainerResource / VoiceoverResource, animation steps keen::ModelHierarchyResource / JointAnimation / AnimationGraphResource2_0"
              }
            }
          }
        },
        "steps": { "type": "array" }
      },
      "allOf": [
        {
          "if": { "properties": { "tool": { "const": "animcook" } }, "required": ["tool"] },
          "then": {
            "properties": {
              "steps": {
                "items": {
                  "if": { "properties": { "tool": { "const": "modelcook" } }, "required": ["tool"] },
                  "then": { "$ref": "#/$defs/modelStep" },
                  "else": {
                    "if": { "properties": { "tool": { "const": "soundcook" } }, "required": ["tool"] },
                    "then": { "$ref": "#/$defs/soundStep" },
                    "else": { "$ref": "#/$defs/animStep" }
                  }
                }
              }
            }
          },
          "else": {
            "if": { "properties": { "tool": { "const": "soundcook" } }, "required": ["tool"] },
            "then": {
              "properties": {
                "steps": {
                  "items": {
                    "if": { "properties": { "tool": { "const": "modelcook" } }, "required": ["tool"] },
                    "then": { "$ref": "#/$defs/modelStep" },
                    "else": {
                      "if": { "properties": { "tool": { "const": "animcook" } }, "required": ["tool"] },
                      "then": { "$ref": "#/$defs/animStep" },
                      "else": { "$ref": "#/$defs/soundStep" }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "steps": {
                  "items": {
                    "if": { "properties": { "tool": { "const": "soundcook" } }, "required": ["tool"] },
                    "then": { "$ref": "#/$defs/soundStep" },
                    "else": {
                      "if": { "properties": { "tool": { "const": "animcook" } }, "required": ["tool"] },
                      "then": { "$ref": "#/$defs/animStep" },
                      "else": { "$ref": "#/$defs/modelStep" }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "steps": { "contains": { "type": "object", "required": ["op"], "properties": { "op": { "enum": ["sound", "cue", "voiceover"] } } } } }, "required": ["steps"] },
          "then": { "required": ["guidNamespace"] }
        }
      ],
      "x-kiln-unknownKeys": "warning"
    },
    "stepTool": { "enum": ["modelcook", "soundcook", "animcook"], "description": "This step's cooker (default: the file's tool)." },
    "modelStep": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "enum": ["model", "visual", "worn"], "x-kiln-message": "modelcook steps are \"model\", \"visual\" or \"worn\" (a sound step needs \"tool\": \"soundcook\")" },
        "tool": { "$ref": "#/$defs/stepTool" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "model" } }, "required": ["op"] },
          "then": {
            "description": "glTF (+ coarser LOD files) -> <out>/<stem>.bin (RenderModel) + <out>/<stem>.blob (GPU data). With skeleton, a skinned model.",
            "required": ["gltf"],
            "anyOf": [ { "required": ["base"] }, { "required": ["material"] }, { "required": ["materialMap"] }, { "required": ["materials"] } ],
            "properties": {
              "op": {}, "tool": {}, "comment": {},
              "gltf": { "$ref": "#/$defs/path" },
              "lods": { "type": "array", "items": { "$ref": "#/$defs/path" }, "description": "Coarser files, coarsest last. The cook refuses more than 8 LODs: no game model has more." },
              "pixelSizes": { "type": "array", "items": { "type": "number", "minimum": 0 }, "description": "One per LOD: 0 first, then rising." },
              "base": { "type": "string", "x-kiln-cook-base": "keen::RenderModel", "description": "A game model: the default materials. Optional when material, materialMap or materials is given." },
              "skeleton": { "type": "string", "minLength": 1, "description": "The glTF's skin is bound to this skeleton: the name of a skeleton step of this recipe, @input of a game skeleton, or @player, the player's." },
              "attach": { "$ref": "#/$defs/attach" },
              "globalScale": { "type": "number", "exclusiveMinimum": 0, "description": "Stored in the model; only cloth uses it. Default: the base's or game skeleton's value, else 1. It doesn't resize the model." },
              "guid": { "$ref": "#/$defs/guidOrInput" },
              "mode": { "enum": ["override", "new"] },
              "name": { "type": "string" },
              "stem": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
              "material": { "$ref": "#/$defs/materialRef", "description": "One material for every primitive: a game material, or a material block of this mod by name." },
              "materialMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/materialRef" }, "description": "glTF material name -> a game material, or a material block of this mod by name." },
              "materials": { "const": "gltf", "description": "Make a material block of every glTF material the step doesn't map: blocks/<stem>.materials.json, and PNGs embedded in the glTF under <out>/materials." }
            },
            "x-kiln-unknownKeys": "warning",
            "x-kiln-unknownKeysMessage": "unknown key in a model step (modelcook ignores it)"
          }
        },
        {
          "if": { "properties": { "op": { "const": "worn" } }, "required": ["op"] },
          "then": {
            "description": "A model worn on the player: the files of a look written in code. A look in blocks/*.json needs no step: the cook finds its files there. <out>/<path with _ for />.bin, .blob and .model.json.",
            "required": ["model"],
            "properties": {
              "op": {}, "tool": {}, "comment": {},
              "model": { "$ref": "#/$defs/modPath" },
              "lods": { "type": "array", "items": { "$ref": "#/$defs/modPath" }, "description": "Coarser files, relative to the mod's folder." },
              "pixelSizes": { "type": "array", "items": { "type": "number", "minimum": 0 }, "description": "One per LOD: 0 first, then rising." },
              "attach": { "$ref": "#/$defs/attach" },
              "materials": { "type": "object", "additionalProperties": { "$ref": "#/$defs/materialRef" }, "description": "glTF material name, or \"*\" for every one -> a game material, or a material block of this mod by name. One it leaves out becomes a block of its own." },
              "skeleton": { "type": "string", "minLength": 1, "description": "Default @player." },
              "globalScale": { "type": "number", "exclusiveMinimum": 0 }
            },
            "x-kiln-unknownKeys": "warning",
            "x-kiln-unknownKeysMessage": "unknown key in a worn step (modelcook ignores it)"
          }
        },
        {
          "if": { "properties": { "op": { "const": "visual" } }, "required": ["op"] },
          "then": {
            "description": "A visual template for a new item: a copy of `base` whose ModelResource points at `model`.",
            "required": ["base", "model", "guid"],
            "properties": {
              "op": {}, "tool": {}, "comment": {},
              "base": { "type": "string", "x-kiln-cook-base": "keen::ecs::TemplateResource" },
              "model": { "$ref": "#/$defs/guidOrInput" },
              "guid": { "$ref": "#/$defs/guidOrInput" },
              "name": { "type": "string" },
              "stem": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
            },
            "x-kiln-unknownKeys": "warning",
            "x-kiln-unknownKeysMessage": "unknown key in a visual step (modelcook ignores it)"
          }
        }
      ]
    },
    "animClip": {
      "type": "object",
      "description": "One clip: an animation of the step's glTF file, or (with \"from\") a clip reworked from another one at cook time. Its name is the key; other steps name it by that.",
      "properties": {
        "comment": {},
        "animation": { "type": "string", "description": "The glTF animation's name. Default: the clip's key. Not with \"from\"." },
        "from": { "type": "string", "minLength": 1, "description": "Rework a clip instead of sampling glTF: @input (one of the game's clips, an input of type keen::JointAnimation) or the key of a clip an earlier entry or step made. The operations run in this order, whatever the order of the keys: trim, reverse, speed, mirror, blend, offset." },
        "trim": { "type": "array", "items": { "type": "number", "minimum": 0 }, "minItems": 2, "maxItems": 2, "description": "[start, end]: keeps that span, in seconds of the source." },
        "reverse": { "type": "boolean", "description": "Plays it backwards." },
        "speed": { "type": "number", "exclusiveMinimum": 0, "description": "The length divided by this (2 plays twice as fast), sampled again at 60 frames a second." },
        "mirror": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "object", "properties": {
                "pairs": { "type": "object", "description": "Left joint -> right joint, where the pairing found from the rest pose is wrong or ambiguous.", "additionalProperties": { "type": "string" } },
                "axis": { "enum": ["x", "y", "z"], "description": "The normal of the plane of symmetry. Default x." },
                "tolerance": { "type": "number", "exclusiveMinimum": 0, "description": "Metres two rest positions may differ by and still pair. Default 0.3 % of the skeleton's size, at least 1 mm." } },
              "additionalProperties": false }
          ],
          "description": "Swaps left and right: true, or { pairs, axis, tolerance }. Pairs are found from the rest pose."
        },
        "blend": {
          "type": "object",
          "description": "Mixes in another clip, stretched to this one's length: by \"weight\" every joint, by \"bones\" only the named joints (not their children unless \"children\": true).",
          "required": ["with"],
          "oneOf": [ { "required": ["weight"] }, { "required": ["bones"] } ],
          "properties": {
            "comment": {},
            "with": { "type": "string", "minLength": 1, "description": "A clip, named as \"from\" names one." },
            "weight": { "type": "number", "minimum": 0, "maximum": 1, "description": "0 is this clip, 1 the other." },
            "bones": {
              "anyOf": [
                { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                { "type": "object", "minProperties": 1, "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
              ],
              "description": "Joints that come from the other clip: a list (weight 1), or { joint: weight }."
            },
            "children": { "type": "boolean", "description": "A named joint's weight covers its children too." }
          },
          "additionalProperties": false
        },
        "offset": {
          "type": "object",
          "minProperties": 1,
          "description": "Joint -> { rotate: [x, y, z] degrees, translate: [x, y, z] metres }, added on top of every frame in the joint's parent space (glTF's axes).",
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "rotate": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "translate": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
            },
            "additionalProperties": false
          }
        },
        "loop": { "type": "boolean", "default": false },
        "rootMotion": {
          "anyOf": [
            { "type": "boolean" },
            { "type": "object", "properties": { "joint": { "type": "string" }, "axes": { "type": "string" }, "rotation": { "type": "boolean" } }, "additionalProperties": false }
          ],
          "description": "Moves the joint's motion to the entity: true, or {joint (default the root), axes (default xz), rotation}."
        },
        "events": {
          "type": "array",
          "description": "Timed events inside the clip: {at, sound | vfx | foot: left/right | noise: range, slot, offset, attach, volumeHint}.",
          "items": {
            "type": "object",
            "required": ["at"],
            "properties": {
              "comment": {},
              "at": { "type": "number", "minimum": 0, "description": "Seconds." },
              "sound": { "$ref": "#/$defs/guidOrInput" },
              "vfx": { "$ref": "#/$defs/guidOrInput" },
              "foot": { "enum": ["left", "right"] },
              "noise": { "type": "number", "minimum": 0, "description": "Metres the AI hears it." },
              "slot": { "type": "string" },
              "offset": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
              "attach": { "type": "boolean" },
              "noiseRange": { "type": "number" },
              "volumeHint": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "guid": { "$ref": "#/$defs/guidOrInput", "description": "Default: follows from the mod and the clip's name. @input with a game clip overrides it." },
        "mode": { "enum": ["new", "override"] },
        "tolerance": { "$ref": "#/$defs/animTolerance" }
      },
      "dependentRequired": { "trim": ["from"], "reverse": ["from"], "speed": ["from"], "mirror": ["from"], "blend": ["from"], "offset": ["from"] },
      "not": { "required": ["from", "animation"] },
      "x-kiln-message": "a clip has \"from\" (reworked from another clip) or \"animation\" (sampled from glTF), not both",
      "additionalProperties": false
    },
    "animTolerance": {
      "type": "object",
      "description": "Largest error the key reduction may leave.",
      "properties": {
        "rotation": { "type": "number", "exclusiveMinimum": 0, "default": 0.0005, "description": "Quaternion components." },
        "position": { "type": "number", "exclusiveMinimum": 0, "default": 0.0002, "description": "Metres." },
        "scale": { "type": "number", "exclusiveMinimum": 0, "default": 0.0005 }
      },
      "additionalProperties": false
    },
    "animSource": {
      "type": "object",
      "description": "What a state or a layer plays: clip, or blend.",
      "properties": {
        "clip": { "type": "string", "description": "A clip of this recipe." },
        "blend": {
          "type": "object",
          "required": ["input", "clips"],
          "properties": {
            "input": { "type": "string", "description": "moveDirection, hitDirection, leanYaw, leanPitch, lookYaw, lookPitch, targetLookYaw, targetLookPitch, headYaw, headPitch; any other name is this mod's own float input, or 0x<hash>." },
            "clips": { "type": "object", "description": "Input value -> clip.", "additionalProperties": { "type": "string" } },
            "circular": { "type": "boolean", "default": true },
            "smoothing": { "type": "number", "minimum": 0, "default": 0.2 }
          },
          "additionalProperties": false
        },
        "loop": { "type": "boolean", "description": "Default: the clip's." },
        "speed": { "type": "number", "exclusiveMinimum": 0, "default": 1 }
      }
    },
    "animRetarget": {
      "description": "The file's animations are on a rig of their own: play them on `skeleton` by pairing joints. Each paired joint turns as its source turns away from the reference pose; translations carry over on the hips, scaled by the rigs' heights.",
      "type": ["object", "boolean"],
      "properties": {
        "map": {
          "oneOf": [ { "type": "object", "additionalProperties": { "type": "string" } }, { "const": "names" } ],
          "description": "Source joint (the file's) -> target joint (the skeleton's; j<index> on a game skeleton). Joints of the same name pair by themselves."
        },
        "byName": { "type": "boolean", "default": true, "description": "Pair joints of the same name that the map leaves out." },
        "skin": { "type": "integer", "minimum": 0, "description": "Which skin of the file is the source rig." },
        "root": { "type": "string", "description": "The source rig's root joint, for a file without a skin." },
        "reference": {
          "type": "object", "required": ["animation"], "additionalProperties": false,
          "description": "A pose of the source that shows the target's rest posture (a T-pose clip for a T-pose skeleton). Default: the file's rest pose.",
          "properties": { "animation": { "type": "string" }, "at": { "type": "number", "minimum": 0, "default": 0 } }
        },
        "translate": { "oneOf": [ { "type": "array", "items": { "type": "string" } }, { "const": "all" } ], "description": "Source joints whose movement carries over, or \"all\" (rigs that move props or IK helpers by translation). Default: the topmost paired joints, and the hips below a root bone on the ground." },
        "scale": { "oneOf": [ { "type": "number", "exclusiveMinimum": 0 }, { "const": "auto" } ], "default": "auto", "description": "How far translations go on the target; auto: the rigs' heights." }
      },
      "additionalProperties": false
    },
    "animStep": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "enum": ["skeleton", "clips", "graph"], "x-kiln-message": "animcook steps are \"skeleton\", \"clips\" or \"graph\"" },
        "tool": { "$ref": "#/$defs/stepTool" }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "skeleton" } }, "required": ["op"] },
          "then": {
            "description": "A glTF file's skeleton -> <out>/<name>.skeleton.bin (ModelHierarchyResource) and <name>.skeleton.json.",
            "required": ["name", "gltf"],
            "properties": {
              "op": {}, "tool": {}, "comment": {},
              "name": { "type": "string", "minLength": 1 },
              "gltf": { "$ref": "#/$defs/path" },
              "skin": { "type": "integer", "minimum": 0, "description": "Which skin, when a file has several with different joints." },
              "root": { "type": "string", "description": "The root joint's node, for a file without a skin." },
              "guid": { "$ref": "#/$defs/guidOrInput" },
              "mode": { "enum": ["new", "override"] }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "op": { "const": "clips" } }, "required": ["op"] },
          "then": {
            "description": "Animations of a glTF file, or clips reworked from others (\"from\") -> <out>/clip_<name>.bin (JointAnimation), with root motion and events under the same GUID.",
            "required": ["skeleton", "clips"],
            "anyOf": [
              { "required": ["gltf"] },
              { "properties": { "clips": { "additionalProperties": { "required": ["from"] } } } }
            ],
            "properties": {
              "op": {}, "tool": {}, "comment": {},
              "skeleton": { "type": "string", "description": "A skeleton step's name, or @input for a game skeleton (joints named j<index>, as tools/kfc exports them)." },
              "gltf": { "$ref": "#/$defs/path", "description": "Needed unless every clip has \"from\"." },
              "clips": { "type": "object", "additionalProperties": { "$ref": "#/$defs/animClip" } },
              "tolerance": { "$ref": "#/$defs/animTolerance" },
              "retarget": { "$ref": "#/$defs/animRetarget" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "op": { "const": "graph" } }, "required": ["op"] },
          "then": {
            "description": "States, blends and layers -> <out>/graph_<name>.bin (AnimationGraphResource2_0) and <name>.graph.json. More than 34 states nest by themselves.",
            "required": ["name", "skeleton"],
            "anyOf": [ { "required": ["states"] }, { "required": ["raw"] } ],
            "properties": {
              "op": {}, "tool": {}, "comment": {},
              "name": { "type": "string", "minLength": 1 },
              "skeleton": { "type": "string" },
              "guid": { "$ref": "#/$defs/guidOrInput" },
              "mode": { "enum": ["new", "override"] },
              "slots": { "type": "object", "description": "keen::AttachmentSlot name -> joint.", "additionalProperties": { "type": "string" } },
              "entry": { "type": "string", "description": "The first state. Default: the engine's Idle, else the first." },
              "raw": { "$ref": "#/$defs/path", "description": "A graph as tools/kfc decodes it, for what states cannot say." },
              "states": {
                "type": "object",
                "description": "State name -> what it plays and what enters it.",
                "additionalProperties": {
                  "allOf": [ { "$ref": "#/$defs/animSource" } ],
                  "properties": {
                    "comment": {},
                    "engine": { "enum": ["Idle", "Walk", "Run", "Sprint", "IdleCombat", "Fall", "IdleSneak", "Sneak", "Dead", "Stun"], "description": "The state id the engine itself sets." },
                    "id": { "type": "string", "description": "A given state id: a GUID or 0x<hash>. Default: follows from the mod and the state's name." },
                    "blendIn": { "type": "number", "minimum": 0, "default": 0.2 },
                    "restart": { "type": "boolean", "default": true },
                    "then": { "type": "string", "description": "Moves on to this state by itself when the clip ends." },
                    "thenBlend": { "type": "number", "minimum": 0 },
                    "clip": {}, "blend": {}, "loop": {}, "speed": {}
                  },
                  "additionalProperties": false
                }
              },
              "layers": {
                "type": "array",
                "description": "Applied in order over the states: playing always, or when an overlay fires.",
                "items": {
                  "required": ["name"],
                  "allOf": [ { "$ref": "#/$defs/animSource" } ],
                  "properties": {
                    "comment": {},
                    "name": { "type": "string" },
                    "mode": { "enum": ["additive", "override"], "default": "additive" },
                    "reference": { "type": "string", "description": "additive: the clip whose pose this one is relative to." },
                    "weight": { "type": "number", "minimum": 0, "default": 1 },
                    "bones": { "description": "Joints it affects: a list, or joint -> weight. Default: all.", "type": ["array", "object"] },
                    "overlay": { "type": "string", "description": "hit (the game's hit flinch), any other name for this mod's own, or 0x<hash>." },
                    "fadeIn": { "type": "number", "minimum": 0 },
                    "fadeOut": { "type": "number", "minimum": 0 },
                    "clip": {}, "blend": {}, "loop": {}, "speed": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "soundName": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,95}$", "x-kiln-message": "a name of letters, digits, _ . - (up to 96; unique per op)" },
    "positional": {
      "anyOf": [
        { "type": "object", "properties": { "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } }, "additionalProperties": false },
        { "const": false },
        { "type": "null" }
      ],
      "x-kiln-message": "positional: {\"min\": m, \"max\": m}, false or null"
    },
    "cueFields": {
      "description": "Cue fields (tools/soundcook/sndcook/recipe.py CUE_FIELDS).",
      "properties": {
        "scene": { "enum": ["Sfx", "Music", "Ui", "Voice"] },
        "playScene": { "enum": ["Ui", "Game", "Music", "Ambience", "LoreVoiceover"] },
        "positional": { "$ref": "#/$defs/positional" },
        "loop": { "type": "boolean" },
        "loopSameChosenEntry": { "type": "boolean" },
        "hasRandomPosition": { "type": "boolean" },
        "muteOnMain": { "type": "boolean" },
        "gamepadSpeaker": { "type": "boolean" },
        "gamepadVibration": { "type": "boolean" },
        "useMaxCountLimiting": { "type": "boolean" },
        "volume": { "type": "number" },
        "volumeRandomness": { "type": "number" },
        "pitch": { "type": "number" },
        "pitchRandomness": { "type": "number" },
        "randomLeftRight": { "type": "number" },
        "randomFrontBack": { "type": "number" },
        "gamepadSpeakerVolume": { "type": "number" },
        "gamepadVibrationIntensity": { "type": "number" },
        "sleep": { "type": "number", "minimum": 0, "description": "Seconds." },
        "sleepRandomness": { "type": "number", "minimum": 0, "description": "Seconds." },
        "avoidRepeatingLastX": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "maxCount": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "stealingMode": { "enum": ["Oldest", "Furthest", "Ignore"] }
      }
    },
    "cueObject": { "type": "object", "$ref": "#/$defs/cueFields", "additionalProperties": false, "properties": { "scene": {}, "playScene": {}, "positional": {}, "loop": {}, "loopSameChosenEntry": {}, "hasRandomPosition": {}, "muteOnMain": {}, "gamepadSpeaker": {}, "gamepadVibration": {}, "useMaxCountLimiting": {}, "volume": {}, "volumeRandomness": {}, "pitch": {}, "pitchRandomness": {}, "randomLeftRight": {}, "randomFrontBack": {}, "gamepadSpeakerVolume": {}, "gamepadVibrationIntensity": {}, "sleep": {}, "sleepRandomness": {}, "avoidRepeatingLastX": {}, "maxCount": {}, "priority": {}, "stealingMode": {} } },
    "sourceOpts": {
      "properties": {
        "channels": { "enum": ["mono", "stereo", "keep"] },
        "gain": { "type": "number" },
        "normalize": { "type": "number", "description": "Loudness target in LUFS (e.g. -24)." },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 }
      },
      "not": { "required": ["gain", "normalize"] },
      "x-kiln-message": "gain and normalize exclude each other"
    },
    "take": {
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "required": ["sound"], "properties": { "sound": { "type": "string", "minLength": 1 }, "chance": { "type": "number", "minimum": 0 } }, "additionalProperties": false }
      ],
      "x-kiln-message": "a take is a sound name, @input, a GUID or {\"sound\": ..., \"chance\": c}"
    },
    "voLang": {
      "type": "string",
      "pattern": "^([Ee][Nn]|[Dd][Ee]|[Ff][Rr]|[Ee][Ss]|[Zz][Hh])([_-][A-Za-z]{2})?$|^([Ee]nglish|[Gg]erman|[Ff]rench|[Ss]panish|[Cc]hinese)$",
      "x-kiln-message": "a voice-over language: en, de, fr, es, zh (or En_Us, De_De, Fr_Fr, Es_Es, Zh_Cn)"
    },
    "soundStep": {
      "type": "object",
      "required": ["op", "name"],
      "properties": {
        "op": { "enum": ["sound", "cue", "voiceover"], "x-kiln-message": "soundcook steps are \"sound\", \"cue\" or \"voiceover\" (a model step needs \"tool\": \"modelcook\")" },
        "tool": { "$ref": "#/$defs/stepTool" },
        "name": { "$ref": "#/$defs/soundName" },
        "comment": {},
        "guid": { "$ref": "#/$defs/guidOrInput" },
        "mode": { "enum": ["new", "override"] }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "sound" } }, "required": ["op"] },
          "then": {
            "required": ["src"],
            "allOf": [{ "$ref": "#/$defs/sourceOpts" }],
            "properties": {
              "op": {}, "tool": {}, "name": {}, "comment": {}, "guid": {}, "mode": {},
              "src": { "$ref": "#/$defs/path", "description": "A WAV, FLAC, Ogg Vorbis or MP3 file (the format is read from its content); may use ../audio/..." },
              "channels": {}, "gain": {}, "normalize": {}, "start": {}, "end": {},
              "debugName": { "type": "string" },
              "cue": { "anyOf": [{ "const": true }, { "$ref": "#/$defs/cueObject" }, { "type": "null" }], "x-kiln-message": "cue: true or an object of cue fields" }
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "op": { "const": "cue" } }, "required": ["op"] },
          "then": {
            "anyOf": [{ "required": ["sounds"] }, { "required": ["base"] }],
            "x-kiln-message": "a cue needs \"sounds\" (or \"base\": a vanilla cue input)",
            "allOf": [{ "$ref": "#/$defs/cueFields" }],
            "properties": {
              "op": {}, "tool": {}, "name": {}, "comment": {}, "guid": {}, "mode": {},
              "sounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/take" } },
              "addSounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/take" } },
              "base": { "type": "string", "x-kiln-cook-base": "keen::SoundContainerResource" },
              "scene": {}, "playScene": {}, "positional": {}, "loop": {}, "loopSameChosenEntry": {}, "hasRandomPosition": {}, "muteOnMain": {}, "gamepadSpeaker": {}, "gamepadVibration": {}, "useMaxCountLimiting": {}, "volume": {}, "volumeRandomness": {}, "pitch": {}, "pitchRandomness": {}, "randomLeftRight": {}, "randomFrontBack": {}, "gamepadSpeakerVolume": {}, "gamepadVibrationIntensity": {}, "sleep": {}, "sleepRandomness": {}, "avoidRepeatingLastX": {}, "maxCount": {}, "priority": {}, "stealingMode": {}
            },
            "additionalProperties": false
          }
        },
        {
          "if": { "properties": { "op": { "const": "voiceover" } }, "required": ["op"] },
          "then": {
            "anyOf": [{ "required": ["languages"] }, { "required": ["base"] }],
            "x-kiln-message": "a voice-over needs \"languages\" (or \"base\": a vanilla voice-over input)",
            "allOf": [{ "$ref": "#/$defs/cueFields" }, { "$ref": "#/$defs/sourceOpts" }],
            "properties": {
              "op": {}, "tool": {}, "name": {}, "comment": {}, "guid": {}, "mode": {},
              "languages": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/voLang" },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "anyOf": [
                      { "$ref": "#/$defs/path" },
                      { "type": "object", "required": ["src"], "allOf": [{ "$ref": "#/$defs/sourceOpts" }], "properties": { "src": { "$ref": "#/$defs/path" }, "channels": {}, "gain": {}, "normalize": {}, "start": {}, "end": {} }, "additionalProperties": false }
                    ],
                    "x-kiln-message": "a path or {src, channels, gain, normalize, start, end}"
                  }
                }
              },
              "fallback": { "anyOf": [{ "$ref": "#/$defs/voLang" }, { "type": "null" }], "description": "The language whose takes fill empty slots; null: silence (absent: the file's voiceoverFallback)." },
              "narration": { "type": "boolean" },
              "subtitles": { "type": "object", "additionalProperties": { "type": "string" } },
              "cue": { "$ref": "#/$defs/cueObject" },
              "languageCue": { "type": "object", "propertyNames": { "$ref": "#/$defs/voLang" }, "additionalProperties": { "$ref": "#/$defs/cueObject" } },
              "channels": {}, "gain": {}, "normalize": {},
              "base": { "type": "string", "x-kiln-cook-base": "keen::VoiceoverResource" },
              "scene": {}, "playScene": {}, "positional": {}, "loop": {}, "loopSameChosenEntry": {}, "hasRandomPosition": {}, "muteOnMain": {}, "gamepadSpeaker": {}, "gamepadVibration": {}, "useMaxCountLimiting": {}, "volume": {}, "volumeRandomness": {}, "pitch": {}, "pitchRandomness": {}, "randomLeftRight": {}, "randomFrontBack": {}, "gamepadSpeakerVolume": {}, "gamepadVibrationIntensity": {}, "sleep": {}, "sleepRandomness": {}, "avoidRepeatingLastX": {}, "maxCount": {}, "priority": {}, "stealingMode": {}
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "description": "{\"native\": \"getSelf\", \"nth\": 0, \"section\": \"code\"}, {\"pc\": 13}, or {\"label\": \"start\"|\"end\"}.",
      "properties": {
        "native": { "type": "string" },
        "nth": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "const": "all" }] },
        "pc": { "type": "integer", "minimum": 0 },
        "label": { "enum": ["start", "end"] },
        "section": { "enum": ["code", "shutdown"] }
      },
      "minProperties": 1
    },
    "code": {
      "anyOf": [
        { "type": "string" },
        { "type": "object", "required": ["file"], "properties": { "file": { "$ref": "#/$defs/path" } } }
      ]
    },
    "edit": {
      "type": "object",
      "description": "tools/impact/impact/patch.py: set, config, var, swap, insert, replace, remove, streams, stack.",
      "properties": {
        "comment": {},
        "set": { "type": "string" }, "value": {},
        "config": { "type": "string" }, "id": {},
        "var": { "type": "string" },
        "swap": { "type": "string" }, "with": { "type": "string" }, "nth": {}, "section": { "enum": ["code", "shutdown"] },
        "insert": { "$ref": "#/$defs/code" }, "before": { "$ref": "#/$defs/anchor" }, "after": { "$ref": "#/$defs/anchor" },
        "replace": { "$ref": "#/$defs/anchor" }, "code": { "$ref": "#/$defs/code" },
        "remove": { "$ref": "#/$defs/anchor" },
        "streams": { "type": "string" },
        "stack": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "required": ["set", "value"] }, { "required": ["config"] }, { "required": ["var"] }, { "required": ["swap", "with"] },
        { "required": ["insert"], "anyOf": [{ "required": ["before"] }, { "required": ["after"] }] },
        { "required": ["replace", "code"] }, { "required": ["remove"] }, { "required": ["streams"] }, { "required": ["stack"] }
      ],
      "x-kiln-message": "an edit is one of {set, value}, {config}, {var}, {swap, with}, {insert, before|after}, {replace, code}, {remove}, {streams}, {stack}",
      "x-kiln-unknownKeys": "warning"
    },
    "impact": {
      "type": "object",
      "description": "impact/cook.json: Impact programs (tools/impact).",
      "required": ["tool"],
      "properties": {
        "format": {},
        "comment": {},
        "tool": { "const": "impact" },
        "out": { "type": "string", "minLength": 1, "default": "../assets/cooked/impact" },
        "manifest": { "$ref": "#/$defs/path", "default": "../assets/assets.json", "description": "The kiln.assets manifest that serves the outputs." },
        "natives": { "type": "array", "items": { "$ref": "#/$defs/path" }, "description": "Kiln natives the programs call (impact/natives.json)." },
        "game": { "$ref": "#/$defs/game" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/input", "properties": { "type": { "const": "keen::ImpactProgram", "x-kiln-message": "tools/impact inputs are keen::ImpactProgram resources" } } }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op", "stem"],
            "properties": { "op": { "enum": ["assemble", "clone"] }, "stem": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$" } },
            "allOf": [
              {
                "if": { "properties": { "op": { "const": "assemble" } }, "required": ["op"] },
                "then": {
                  "required": ["src"],
                  "properties": {
                    "op": {}, "stem": {}, "comment": {},
                    "src": { "$ref": "#/$defs/path", "pattern": "\\.kimp$" },
                    "guid": { "$ref": "#/$defs/guid" },
                    "mode": { "enum": ["override", "new"] }
                  },
                  "x-kiln-unknownKeys": "warning"
                }
              },
              {
                "if": { "properties": { "op": { "const": "clone" } }, "required": ["op"] },
                "then": {
                  "required": ["base", "guid"],
                  "properties": {
                    "op": {}, "stem": {}, "comment": {},
                    "base": { "type": "string", "x-kiln-cook-base": "keen::ImpactProgram" },
                    "guid": { "$ref": "#/$defs/guid" },
                    "edits": { "type": "array", "items": { "$ref": "#/$defs/edit" } },
                    "keepSites": { "type": "boolean" },
                    "mode": { "enum": ["override", "new"] }
                  },
                  "x-kiln-unknownKeys": "warning"
                }
              }
            ]
          }
        }
      },
      "x-kiln-unknownKeys": "warning"
    }
  }
}
