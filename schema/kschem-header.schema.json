{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kschem-header.schema.json",
  "title": "Kiln schematic header (the JSON inside a .kschem file), version 1",
  "description": "The UTF-8 JSON header of a .kschem file (KSCHEM\\r\\n, u32 version 1, u32 header length, header, u32 cell data length, raw DEFLATE cells). Read by managed/services/Kiln.Build/Schematic.cs (System.Text.Json JsonNode: plain JSON). Docs: docs/kiln/services/build.md#the-kschem-format-version-1.",
  "type": "object",
  "x-kiln-docs": "docs/kiln/services/build.md#the-kschem-format-version-1",
  "required": ["size"],
  "properties": {
    "format": { "const": "kiln.schematic" },
    "version": { "const": 1 },
    "name": { "type": "string" },
    "author": { "type": "string" },
    "description": { "type": "string" },
    "size": {
      "type": "array",
      "description": "Cells x, y, z (at most 4 M cells in all).",
      "prefixItems": [{ "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }, { "type": "integer", "minimum": 1 }],
      "minItems": 3,
      "maxItems": 3
    },
    "cellSize": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 },
    "anchor": {
      "type": "array",
      "description": "The paste point, in cells from the low corner (default: bottom centre).",
      "prefixItems": [{ "type": "integer" }, { "type": "integer" }, { "type": "integer" }],
      "minItems": 3,
      "maxItems": 3
    },
    "cellOrder": { "const": "x,y,z" },
    "cellEncoding": { "type": "string" },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template", "pos"],
        "properties": {
          "template": {
            "type": "string",
            "pattern": "^\\{?[0-9a-fA-F]{8}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{4}-?[0-9a-fA-F]{12}\\}?$",
            "x-kiln-ref": "templates",
            "x-kiln-ref-forms": ["guid"]
          },
          "name": { "type": "string" },
          "pos": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "Metres from the low corner." },
          "rot": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "Quaternion x y z w." },
          "item": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "UsedItem: 0 = the item that places the template, 4294967295 = none." }
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Where it was captured (optional, informational).",
      "properties": {
        "world": { "type": "string" },
        "box": { "type": "array", "items": { "type": "integer" }, "minItems": 6, "maxItems": 6 },
        "corner": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "kiln": { "type": "string" },
        "captured": { "type": "string" }
      }
    }
  }
}
