{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state-boot.schema.json",
  "title": "Boot report (<game>/kiln/state/boot.json), format 1",
  "description": "Written atomically (tmp + rename) by kiln-core at the end of kiln_boot, before the game's entry point runs, on servers and clients. A file whose pid is not a live process is stale. Managed mods load later: see state/mods.json.",
  "type": "object",
  "required": [
    "format",
    "kiln",
    "pid",
    "written",
    "side",
    "hooks",
    "profile"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "kiln": {
      "type": "string",
      "description": "Core version (KILN_VERSION)."
    },
    "abi": {
      "type": "integer"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "description": "Windows pid of the game process (as Wine reports it)."
    },
    "written": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "bootMs": {
      "type": "number",
      "minimum": 0
    },
    "side": {
      "$ref": "common.schema.json#/$defs/runSide"
    },
    "exe": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "verified": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "enum": [
        "verified-only",
        "any"
      ]
    },
    "hooks": {
      "type": "boolean",
      "description": "false = safe idle."
    },
    "safeIdle": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why hooks are off (unverified build, no definitions), null when on."
    },
    "playOnce": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "no-mods",
            "profile",
            "ignored-expired",
            "ignored-undeletable",
            "ignored-server",
            "ignored-invalid"
          ]
        },
        "nonce": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "legacy",
            "active",
            "once",
            "no-mods",
            "invalid"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "file": {
          "type": [
            "string",
            "null"
          ],
          "description": "The profile file read (game-side path)."
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "description": "mode invalid: why."
        },
        "configDir": {
          "type": "string"
        },
        "dataDir": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "properties": {
            "kiln": {
              "type": "integer"
            },
            "native": {
              "type": "integer"
            },
            "plugin": {
              "type": "integer"
            },
            "emf": {
              "type": "integer"
            }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "description": "KILN_PATH_* as the core resolved them (game-side).",
      "properties": {
        "game": {
          "type": "string"
        },
        "kiln": {
          "type": "string"
        },
        "mods": {
          "type": "string"
        },
        "logs": {
          "type": "string"
        },
        "data": {
          "type": "string"
        },
        "control": {
          "type": "string"
        },
        "config": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "chain": {
      "type": "array",
      "description": "What the proxy did with each chained DLL (KilnBootInfo v2 chain[]), in load order: kiln/chain.ini [chain], <game>/dinput8-chain.ini, then kiln/chain.ini [profile] (or kiln/chain/once.ini). Entries deferred by [late] stay in this position and carry `late: true`.",
      "items": {
        "type": "object",
        "required": [
          "path",
          "source",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Canonical full path as the proxy resolved it."
          },
          "source": {
            "enum": [
              "chain",
              "emf",
              "profile"
            ]
          },
          "status": {
            "enum": [
              "loaded",
              "failed",
              "missing",
              "refused",
              "duplicate",
              "skipped"
            ]
          },
          "detail": {
            "enum": [
              null,
              "self",
              "system",
              "kiln",
              "shroudforge",
              "not-dll",
              "outside",
              "too-many"
            ],
            "description": "status refused: KILN_CHAIN_REFUSED_* (self, system = system dinput8 / Wine builtin, kiln = a Kiln proxy or kiln-core.dll, shroudforge, not-dll = not a 64-bit PE DLL, outside = a dinput8-chain.ini entry outside the game folder, too-many = past 256 in its section)."
          },
          "error": {
            "type": "integer",
            "description": "status failed: the Win32 error code."
          },
          "late": {
            "const": true,
            "description": "dev.21: the entry's DLL is also named in kiln/chain.ini [late]. The proxy did not load it; kiln-core loaded it after the plugins, and `status` is the core's result (loaded, failed, missing, duplicate; skipped when the late phase did not run, or when its native mod is disabled, on the other side or refused). Absent for every other entry. EMF's own loader is never deferred, so it never carries it."
          },
          "lateIgnored": {
            "const": true,
            "description": "dev.21, with `late`: the DLL was in the process before the late phase (another loader started it, such as EMF's loader with dinput8-chain.ini), so [late] moved nothing; `status` is loaded. Absent otherwise."
          }
        }
      },
      "default": []
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Registered service names (with version, e.g. kiln.profile@1)."
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "status"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "enum": [
              "loaded",
              "failed",
              "skipped"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "native": {
      "type": "object",
      "description": "Summary; details in state/native.json.",
      "properties": {
        "loaded": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "pending": {
          "type": "integer"
        }
      }
    },
    "clr": {
      "type": "object",
      "properties": {
        "started": {
          "type": "boolean"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Boot errors worth showing to the player."
    },
    "boot": {
      "type": "object",
      "description": "Mod.OnBoot's generation (kiln.boot, since 0.2.0-dev.28; docs/kiln/services/boot.md): whether this process took the deferred route, each boot mod's state and every issue.",
      "required": ["deferred", "reason", "bootMods", "status", "generation", "published", "exitCode", "collectors", "owners", "issues"],
      "properties": {
        "deferred": { "type": "boolean", "description": "The boot phase ran in this process (an enabled boot mod, hooks and .NET on, mods.boot available)." },
        "reason": { "type": "string", "description": "Why the phase is on or off, in plain words." },
        "bootMods": { "type": "array", "items": { "type": "string" }, "description": "The boot mods of the profile scan, \"<id>\" or \"<id> (required)\"." },
        "status": { "enum": ["collecting", "preparing", "published", "aborted", "activation-fault", null] },
        "generation": { "type": ["integer", "null"], "description": "1 when the phase ran (one generation per process), else null." },
        "published": { "type": "boolean" },
        "exitCode": { "type": ["integer", "null"], "description": "19201 (0x4B01) when the start stopped, else null." },
        "collectors": { "type": "array", "items": { "type": "string" }, "description": "The collectors registered: assets, worldtables, content, skills, knowledge, vfx, patches." },
        "owners": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "state", "required", "author", "definitions", "issues"],
            "properties": {
              "id": { "type": "string" },
              "state": { "enum": ["not-participating", "staged", "committed", "excluded-callback", "excluded-dependency", "rejected-prepare", "generation-aborted", "missed-phase", "activation-fault"] },
              "required": { "type": "boolean", "description": "\"boot\": \"required\" in its kiln.mod.json." },
              "author": { "type": "boolean", "description": "It ran OnBoot (false: it took part with its files only)." },
              "definitions": { "type": "integer", "minimum": 0, "description": "What it staged (0 once it is out)." },
              "issues": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["mod", "kind", "key", "phase", "code", "warning", "reason"],
            "properties": {
              "mod": { "type": ["string", "null"] },
              "kind": { "type": ["string", "null"] },
              "key": { "type": ["string", "null"] },
              "phase": { "type": "string", "description": "stage, callback, prepare, commit, activate." },
              "code": { "type": "string", "description": "DuplicateDefinition, CallbackFailed, Dependency, PrepareRefused, GenerationAborted, ..." },
              "warning": { "type": "boolean" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "waitedFor": {
      "type": "array",
      "description": "Other loaders' modules Kiln waited for before it hooked, in order (foreign_scan.h: the shroudlink client addon's live-code scans; one 10-second budget for the whole boot). Empty when there was none to wait for; older cores do not write it.",
      "items": {
        "type": "object",
        "required": [
          "module",
          "end",
          "ms",
          "line"
        ],
        "properties": {
          "module": {
            "type": "string",
            "description": "The module's file name."
          },
          "end": {
            "enum": [
              "ready",
              "hooked",
              "switched-off",
              "timeout"
            ],
            "description": "ready: its log reported a complete, current startup; hooked: its UI hook reaches into that module; switched-off: its log says its UI is off; timeout: the wait budget ran out."
          },
          "ms": {
            "type": "integer",
            "minimum": 0,
            "description": "How long Kiln waited for it."
          },
          "line": {
            "type": [
              "string",
              "null"
            ],
            "description": "The module's log line that ended the wait; null without one."
          }
        }
      }
    }
  },
  "additionalProperties": true
}
