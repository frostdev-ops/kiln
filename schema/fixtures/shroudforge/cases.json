    {
      "name": "comment-ends-at-a-lone-cr",
      "about": "a // comment ends at a lone CR too (System.Text.Json, ShroudForge's editor): the edit changes j, not k",
      "mod": {
        "id": "lone-cr",
        "name": "lone-cr",
