          "enabled": false,
          "ok": true
        },
        {
          "setting": "gain",
          "value": 1.5,
          "ok": true
        },
        {
          "setting": "count",
          "value": 1.5,
          "ok": false
        }
      ],
      "expect": "{\n  \"enabled\": false,\n  \"settings\": {\n    \"multipliers\": {\"value\": [2.0, 1.5], \"options\": {\"1.5\": \"1.5x\", \"2\": \"2x\", \"2.5\": \"2.5x\"}},\n    \"gain\": {\"value\": 1.5, \"options\": {\"1.5\": \"Low\", \"2\": \"High\"}},\n    \"count\": {\"value\": 2, \"options\": {\"1\": \"One\", \"2\": \"Two\"}}\n  }\n}\n",
      "enabledAfter": [
        "multipliers",
        "gain",
        "count"
      ]
    },
