            "key": "multipliers",
            "type": "array",
            "label": "multipliers",
            "control": "multiselect",
            "applyAt": "restart",
            "live": true,
            "options": [
              {
                "value": 1.5,
                "label": "1.5x"
              },
              {
                "value": 2.0,
                "label": "2x"
              },
              {
                "value": 2.5,
                "label": "2.5x"
              }
            ]
          },
          {
            "key": "gain",
            "type": "number",
            "label": "gain",
            "control": "select",
            "applyAt": "restart",
            "live": true,
            "options": [
              {
                "value": 1.5,
                "label": "Low"
              },
              {
                "value": 2.0,
                "label": "High"
              }
            ]
          },
          {
            "key": "count",
            "type": "integer",
            "label": "count",
            "control": "select",
            "applyAt": "restart",
            "live": true,
            "options": [
              {
                "value": 1,
                "label": "One"
              },
              {
                "value": 2,
                "label": "Two"
