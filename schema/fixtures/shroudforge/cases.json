      "read": {
        "enabled": false,
        "switchLive": true,
        "settings": [
          {
            "key": "x",
            "type": "integer",
            "label": "x",
            "control": null,
            "applyAt": "restart",
            "live": true
          }
        ],
        "enabledNow": [
          "x"
        ]
      },
      "edits": [
        {
          "setting": "x",
          "value": 20,
          "ok": true
        },
        {
          "setting": "x",
          "value": 101,
          "ok": false
        },
        {
          "enabled": true,
          "ok": true
        }
      ],
      "expect": "{\r\n  \"enabled\": true,\r\n  \"settings\": {\r\n    \"x\": {\r\n      \"value\": 20,\r\n      \"min\": 0,\r\n      \"max\": 100\r\n    }\r\n  }\r\n}\r\n"
    },
