{
  "about": "ShroudForge mod packages (mod.json + extended.mod.json): how a setting reads (type, label, control, when it applies, enabledWhen) and how the switch and the settings are written (only the value changes, the rest of the file stays byte-identical). Run by crates/kiln-manage/tests/shroudforge_fixtures.rs (the launcher) and managed/tests/Kiln.Ui.Tests/ShroudForgeTests.cs (the in-game Mods page); ShroudForge's own rules: modules/modloader/read_mod_settings.rs, validate_mod_settings.rs and mod-runtime/ingame/refresh_runtime_configuration.rs in the fork. Edits run in order; a refused edit leaves the file as it was.",
  "cases": [
    {
      "name": "runtime-mod",
      "about": "sf-survival's shape: a runtime mod, settings without applyAt (ShroudForge's default: restart), one group",
      "mod": {
        "id": "sf-survival",
        "name": "Survival",
        "version": "1.0.0",
        "capabilities": [
          "runtime"
        ]
      },
      "extended": "{\n  \"$schema\": \"https://bonsaibauer.github.io/shroudforge/schemas/extended.mod.schema.json\",\n  \"schemaVersion\": 1,\n  \"enabled\": false,\n  \"targets\": [\n    \"client\",\n    \"server\"\n  ],\n  \"settings\": {\n    \"noFallDamage\": {\n      \"value\": true,\n      \"label\": \"No Fall Damage\",\n      \"description\": \"Turns off fall damage.\"\n    },\n    \"infiniteStamina\": {\n      \"value\": true,\n      \"label\": \"Infinite Stamina\"\n    }\n  },\n  \"groups\": [\n    {\n      \"label\": \"Survival\",\n      \"description\": \"Turn individual survival options on or off.\",\n      \"settings\": [\n        \"noFallDamage\",\n        \"infiniteStamina\"\n      ]\n    }\n  ]\n}\n",
      "read": {
        "enabled": false,
        "switchLive": true,
        "settings": [
          {
            "key": "noFallDamage",
            "type": "boolean",
            "label": "No Fall Damage",
            "control": null,
            "applyAt": "restart",
            "live": true
          },
          {
            "key": "infiniteStamina",
            "type": "boolean",
            "label": "Infinite Stamina",
            "control": null,
            "applyAt": "restart",
            "live": true
          }
        ],
        "enabledNow": [
          "noFallDamage",
          "infiniteStamina"
        ]
      },
      "edits": [
        {
          "setting": "noFallDamage",
          "value": false,
          "ok": true
        },
        {
          "enabled": true,
          "ok": true
        },
        {
          "setting": "infiniteStamina",
          "value": "yes",
          "ok": false
        },
        {
          "setting": "nope",
          "value": 1,
          "ok": false
        }
      ],
      "expect": "{\n  \"$schema\": \"https://bonsaibauer.github.io/shroudforge/schemas/extended.mod.schema.json\",\n  \"schemaVersion\": 1,\n  \"enabled\": true,\n  \"targets\": [\n    \"client\",\n    \"server\"\n  ],\n  \"settings\": {\n    \"noFallDamage\": {\n      \"value\": false,\n      \"label\": \"No Fall Damage\",\n      \"description\": \"Turns off fall damage.\"\n    },\n    \"infiniteStamina\": {\n      \"value\": true,\n      \"label\": \"Infinite Stamina\"\n    }\n  },\n  \"groups\": [\n    {\n      \"label\": \"Survival\",\n      \"description\": \"Turn individual survival options on or off.\",\n      \"settings\": [\n        \"noFallDamage\",\n        \"infiniteStamina\"\n      ]\n    }\n  ]\n}\n"
    },
    {
      "name": "patch-mod",
      "about": "sf-crafting-essentials' shape: startup asset changes plus a runtime part; only settings declared live apply live, the switch at the next start",
      "mod": {
        "id": "sf-crafting-essentials",
        "name": "Crafting Essentials",
        "version": "1.0.0",
        "capabilities": [
          "patch",
          "runtime"
        ]
      },
      "extended": "{\n  \"schemaVersion\": 1,\n  \"enabled\": true,\n  \"targets\": [\"client\", \"server\"],\n  \"settings\": {\n    \"noResourceCost\": {\n      \"value\": false,\n      \"label\": \"No Recipe Resource Costs\",\n      \"control\": \"checkbox\",\n      \"applyAt\": \"restart\",\n      \"restartRequired\": true\n    },\n    \"infiniteItemUse\": {\n      \"value\": false,\n      \"label\": \"No Item Consumption\",\n      \"control\": \"checkbox\",\n      \"applyAt\": \"live\",\n      \"restartRequired\": false\n    },\n    \"productionTimeMode\": {\n      \"value\": \"original\",\n      \"control\": \"select\",\n      \"options\": {\n        \"original\": \"Original recipe times\",\n        \"fixed\": \"One shared time\"\n      }\n    },\n    \"productionSeconds\": {\n      \"value\": 3,\n      \"label\": \"Production Time in Seconds\",\n      \"control\": \"slider\",\n      \"min\": 1,\n      \"max\": 900,\n      \"step\": 1,\n      \"enabledWhen\": {\n        \"setting\": \"productionTimeMode\",\n        \"equals\": \"fixed\"\n      },\n      \"restartRequired\": false\n    }\n  }\n}\n",
      "read": {
        "enabled": true,
        "switchLive": false,
        "settings": [
          {
            "key": "noResourceCost",
            "type": "boolean",
            "label": "No Recipe Resource Costs",
            "control": "checkbox",
            "applyAt": "restart",
            "live": false
          },
          {
            "key": "infiniteItemUse",
            "type": "boolean",
            "label": "No Item Consumption",
            "control": "checkbox",
            "applyAt": "live",
            "live": true
          },
          {
            "key": "productionTimeMode",
            "type": "string",
            "label": "production Time Mode",
            "control": "select",
            "applyAt": "restart",
            "live": false,
            "options": [
              {
                "value": "original",
                "label": "Original recipe times"
              },
              {
                "value": "fixed",
                "label": "One shared time"
              }
            ]
          },
          {
            "key": "productionSeconds",
            "type": "integer",
            "label": "Production Time in Seconds",
            "control": "slider",
            "applyAt": "live",
            "live": true,
            "enabledWhen": {
              "setting": "productionTimeMode",
              "equals": "fixed"
            }
          }
        ],
        "enabledNow": [
          "noResourceCost",
          "infiniteItemUse",
          "productionTimeMode"
        ]
      },
      "edits": [
        {
          "setting": "productionTimeMode",
          "value": "fixed",
          "ok": true
        },
        {
          "setting": "productionSeconds",
          "value": 900,
          "ok": true
        },
        {
          "setting": "productionSeconds",
          "value": 901,
          "ok": false
        },
        {
          "setting": "productionSeconds",
          "value": 2.5,
          "ok": false
        },
        {
          "setting": "productionSeconds",
          "value": 12.0,
          "ok": true
        },
        {
          "setting": "productionTimeMode",
          "value": "bogus",
          "ok": false
        },
        {
          "enabled": false,
          "ok": true
        }
      ],
      "expect": "{\n  \"schemaVersion\": 1,\n  \"enabled\": false,\n  \"targets\": [\"client\", \"server\"],\n  \"settings\": {\n    \"noResourceCost\": {\n      \"value\": false,\n      \"label\": \"No Recipe Resource Costs\",\n      \"control\": \"checkbox\",\n      \"applyAt\": \"restart\",\n      \"restartRequired\": true\n    },\n    \"infiniteItemUse\": {\n      \"value\": false,\n      \"label\": \"No Item Consumption\",\n      \"control\": \"checkbox\",\n      \"applyAt\": \"live\",\n      \"restartRequired\": false\n    },\n    \"productionTimeMode\": {\n      \"value\": \"fixed\",\n      \"control\": \"select\",\n      \"options\": {\n        \"original\": \"Original recipe times\",\n        \"fixed\": \"One shared time\"\n      }\n    },\n    \"productionSeconds\": {\n      \"value\": 12,\n      \"label\": \"Production Time in Seconds\",\n      \"control\": \"slider\",\n      \"min\": 1,\n      \"max\": 900,\n      \"step\": 1,\n      \"enabledWhen\": {\n        \"setting\": \"productionTimeMode\",\n        \"equals\": \"fixed\"\n      },\n      \"restartRequired\": false\n    }\n  }\n}\n",
      "enabledAfter": [
        "noResourceCost",
        "infiniteItemUse",
        "productionTimeMode",
        "productionSeconds"
      ]
    },
    {
      "name": "one-line-file",
      "about": "a shorthand setting (key = value), numbers with a fraction, text with escapes and a length limit, enabledWhen comparing 5 with 5.0, and a switch the file does not have yet",
      "mod": {
        "id": "one-line",
        "name": "One line",
        "version": "0.1.0",
        "capabilities": [
          "runtime"
        ]
      },
      "extended": "{\"settings\": {\"raw\": 5, \"ratio\": {\"value\": 1.5, \"min\": 0, \"max\": 2, \"step\": 0.25, \"restartRequired\": false, \"enabledWhen\": {\"setting\": \"raw\", \"equals\": 5.0}}, \"name\": {\"value\": \"Ä\", \"control\": \"text\", \"maxLength\": 4}}}\n",
      "read": {
        "enabled": false,
        "switchLive": true,
        "settings": [
          {
            "key": "raw",
            "type": "integer",
            "label": "raw",
            "control": null,
            "applyAt": "restart",
            "live": true
          },
          {
            "key": "ratio",
            "type": "number",
            "label": "ratio",
            "control": null,
            "applyAt": "live",
            "live": true,
            "enabledWhen": {
              "setting": "raw",
              "equals": 5.0
            }
          },
          {
            "key": "name",
            "type": "string",
            "label": "name",
            "control": "text",
            "applyAt": "restart",
            "live": true
          }
        ],
        "enabledNow": [
          "raw",
          "ratio",
          "name"
        ]
      },
      "edits": [
        {
          "setting": "raw",
          "value": 9223372036854775808,
          "ok": false
        },
        {
          "setting": "raw",
          "value": 7,
          "ok": true
        },
        {
          "setting": "ratio",
          "value": 2,
          "ok": true
        },
        {
          "setting": "ratio",
          "value": 2.25,
          "ok": false
        },
        {
          "setting": "ratio",
          "value": 0.75,
          "ok": true
        },
        {
          "setting": "raw",
          "value": true,
          "ok": false
        },
        {
          "setting": "name",
          "value": "a\"b\\",
          "ok": true
        },
        {
          "setting": "name",
          "value": "toolong",
          "ok": false
        },
        {
          "enabled": true,
          "ok": true
        }
      ],
      "expect": "{\"settings\": {\"raw\": 7, \"ratio\": {\"value\": 0.75, \"min\": 0, \"max\": 2, \"step\": 0.25, \"restartRequired\": false, \"enabledWhen\": {\"setting\": \"raw\", \"equals\": 5.0}}, \"name\": {\"value\": \"a\\\"b\\\\\", \"control\": \"text\", \"maxLength\": 4}}, \"enabled\": true}\n",
      "enabledAfter": [
        "raw",
        "name"
      ]
    },
