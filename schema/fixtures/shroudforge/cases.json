    {
      "name": "fractional-list",
      "about": "a list typed by a fractional first member: whole members are written with a fraction (1.0), or ShroudForge would type the list by an integer first member and refuse the fractional option keys",
      "mod": {
        "id": "fractional-list",
        "name": "fractional-list",
        "version": "1.0.0",
        "capabilities": [
          "runtime"
        ]
      },
      "extended": "{\n  \"enabled\": true,\n  \"settings\": {\n    \"multipliers\": {\n      \"value\": [1.5],\n      \"label\": \"Multipliers\",\n      \"options\": {\"1.0\": \"1x\", \"1.5\": \"1.5x\", \"2.5\": \"2.5x\"}\n    }\n  }\n}\n",
      "read": {
        "enabled": true,
        "switchLive": true,
        "settings": [
          {
            "key": "multipliers",
            "type": "array",
            "label": "Multipliers",
            "control": "multiselect",
            "applyAt": "restart",
            "live": true,
            "options": [
              {
                "value": 1.0,
                "label": "1x"
              },
              {
                "value": 1.5,
                "label": "1.5x"
              },
              {
                "value": 2.5,
                "label": "2.5x"
              }
            ]
          }
        ],
        "enabledNow": [
          "multipliers"
        ]
      },
      "edits": [
        {
          "setting": "multipliers",
          "value": [
            2.5,
            1
          ],
          "ok": true
        },
        {
          "setting": "multipliers",
          "value": [
            2
          ],
          "ok": false
        },
        {
          "setting": "multipliers",
          "value": [
            1.0,
            2.5
          ],
          "ok": true
        }
      ],
      "expect": "{\n  \"enabled\": true,\n  \"settings\": {\n    \"multipliers\": {\n      \"value\": [1.0, 2.5],\n      \"label\": \"Multipliers\",\n      \"options\": {\"1.0\": \"1x\", \"1.5\": \"1.5x\", \"2.5\": \"2.5x\"}\n    }\n  }\n}\n",
      "enabledAfter": [
        "multipliers"
      ]
    },
    {
      "name": "damaged-fractional-values-are-repaired",
      "about": "what an earlier Kiln wrote for a fractional setting (a whole value without its fraction): ShroudForge refuses it (an integer first member, fractional option keys); it is read as the fractional setting it was and repaired by the next write. An integer setting with whole option keys stays an integer setting",
      "mod": {
        "id": "damaged",
        "name": "damaged",
        "version": "1.0.0",
        "capabilities": [
          "runtime"
        ]
      },
      "extended": "{\n  \"enabled\": true,\n  \"settings\": {\n    \"multipliers\": {\"value\": [2, 1.5], \"options\": {\"1.5\": \"1.5x\", \"2\": \"2x\", \"2.5\": \"2.5x\"}},\n    \"gain\": {\"value\": 2, \"options\": {\"1.5\": \"Low\", \"2\": \"High\"}},\n    \"count\": {\"value\": 2, \"options\": {\"1\": \"One\", \"2\": \"Two\"}}\n  }\n}\n",
