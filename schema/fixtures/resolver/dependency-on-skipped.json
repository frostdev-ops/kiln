{
  "description": "A dependency on a skipped mod says so",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "server",
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": []
  },
  "mods": [
    {
      "dir": "/mods/c",
      "manifest": {
        "id": "c",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "side": "client"
      }
    },
    {
      "dir": "/mods/app",
      "manifest": {
        "id": "app",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "dependencies": {
          "c": "*"
        }
      }
    }
  ],
  "expect": {
    "order": [],
    "rejected": [
      {
        "id": "app",
        "dir": "/mods/app",
        "state": "failed",
        "reason": "dependency c * did not load (skipped: side 'client': not loaded on a server)"
      },
      {
        "id": "c",
        "dir": "/mods/c",
        "state": "skipped",
        "reason": "side 'client': not loaded on a server"
      }
    ]
  }
}
