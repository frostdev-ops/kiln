{
  "description": "Server mods load on a client that hosts a world (the player's own world: single-player or co-op), and so do the mods that need them",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "client",
    "hosting": true,
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": []
  },
  "mods": [
    {
      "dir": "/mods/s",
      "manifest": {
        "id": "s",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    },
    {
      "dir": "/mods/c",
      "manifest": {
        "id": "c",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "side": "client"
      }
    },
    {
      "dir": "/mods/b",
      "manifest": {
        "id": "b",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "side": "both"
      }
    },
    {
      "dir": "/mods/d",
      "manifest": {
        "id": "d",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "side": "client",
        "dependencies": {
          "s": "*"
        }
      }
    },
    {
      "dir": "/mods/x",
      "manifest": {
        "id": "x",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "dependencies": {
          "nope": "^1"
        }
      }
    }
  ],
  "expect": {
    "order": [
      "b",
      "c",
      "s",
      "d"
    ],
    "rejected": [
      {
        "id": "x",
        "dir": "/mods/x",
        "state": "failed",
        "reason": "missing dependency nope ^1"
      }
    ]
  }
}
