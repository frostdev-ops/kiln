{
  "description": "loadBefore/loadAfter order without requiring",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "server",
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": []
  },
  "mods": [
    {
      "dir": "/mods/a",
      "manifest": {
        "id": "a",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "loadAfter": [
          "b",
          "nothere"
        ]
      }
    },
    {
      "dir": "/mods/b",
      "manifest": {
        "id": "b",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    },
    {
      "dir": "/mods/c",
      "manifest": {
        "id": "c",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "loadBefore": [
          "b"
        ]
      }
    }
  ],
  "expect": {
    "order": [
      "c",
      "b",
      "a"
    ],
    "rejected": []
  }
}
