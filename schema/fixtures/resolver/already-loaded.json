{
  "description": "Resolves against mods already running",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "server",
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": [
      {
        "id": "lib",
        "version": "1.5.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    ]
  },
  "mods": [
    {
      "dir": "/mods/app",
      "manifest": {
        "id": "app",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "dependencies": {
          "lib": "^1.2"
        }
      }
    },
    {
      "dir": "/mods/lib",
      "manifest": {
        "id": "lib",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    }
  ],
  "expect": {
    "order": [
      "app"
    ],
    "rejected": [
      {
        "id": "lib",
        "dir": "/mods/lib",
        "state": "failed",
        "reason": "mod lib is already loaded"
      }
    ]
  }
}
