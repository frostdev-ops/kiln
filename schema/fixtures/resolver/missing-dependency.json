{
  "description": "A missing dependency fails only that mod",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "server",
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": []
  },
  "mods": [
    {
      "dir": "/mods/needy",
      "manifest": {
        "id": "needy",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "dependencies": {
          "gone": "^1.0"
        }
      }
    },
    {
      "dir": "/mods/fine",
      "manifest": {
        "id": "fine",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    }
  ],
  "expect": {
    "order": [
      "fine"
    ],
    "rejected": [
      {
        "id": "needy",
        "dir": "/mods/needy",
        "state": "failed",
        "reason": "missing dependency gone ^1.0"
      }
    ]
  }
}
