{
  "description": "A version mismatch names both sides",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "server",
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": []
  },
  "mods": [
    {
      "dir": "/mods/lib",
      "manifest": {
        "id": "lib",
        "version": "1.2.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    },
    {
      "dir": "/mods/app",
      "manifest": {
        "id": "app",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "dependencies": {
          "lib": "[2.0,3.0)"
        }
      }
    }
  ],
  "expect": {
    "order": [
      "lib"
    ],
    "rejected": [
      {
        "id": "app",
        "dir": "/mods/app",
        "state": "failed",
        "reason": "needs lib [2.0,3.0), found lib 1.2.0"
      }
    ]
  }
}
