{
  "description": "Server mods are skipped on a client",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "client",
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": []
  },
  "mods": [
    {
      "dir": "/mods/s",
      "manifest": {
        "id": "s",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    },
    {
      "dir": "/mods/c",
      "manifest": {
        "id": "c",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "side": "client"
      }
    },
    {
      "dir": "/mods/b",
      "manifest": {
        "id": "b",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "side": "both"
      }
    }
  ],
  "expect": {
    "order": [
      "b",
      "c"
    ],
    "rejected": [
      {
        "id": "s",
        "dir": "/mods/s",
        "state": "skipped",
        "reason": "side 'server': not loaded on a client"
      }
    ]
  }
