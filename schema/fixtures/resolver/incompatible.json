{
  "description": "incompatible fails the declaring mod",
  "env": {
    "kiln": "0.1.0-dev",
    "api": "0.2.0",
    "side": "server",
    "unavailableFeatures": [
      "missing.feature"
    ],
    "loaded": []
  },
  "mods": [
    {
      "dir": "/mods/lib",
      "manifest": {
        "id": "lib",
        "version": "1.2.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll"
      }
    },
    {
      "dir": "/mods/rival",
      "manifest": {
        "id": "rival",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "incompatible": {
          "lib": "^1"
        }
      }
    },
    {
      "dir": "/mods/ok",
      "manifest": {
        "id": "ok",
        "version": "1.0.0",
        "apiVersion": "0.2",
        "entryAssembly": "M.dll",
        "incompatible": {
          "lib": "^2"
        }
      }
    }
  ],
  "expect": {
    "order": [
      "lib",
      "ok"
    ],
    "rejected": [
      {
        "id": "rival",
        "dir": "/mods/rival",
        "state": "failed",
        "reason": "incompatible with lib 1.2.0 (declared in its incompatible list)"
      }
    ]
  }
}
